:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x100cd43e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x100cd4560 .scope module, "probe" "probe" 3 2;
 .timescale -9 -12;
v0x100cd0ec0_0 .var "a", 3 0;
    .scope S_0x100cd4560;
T_0 ;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x100cd0ec0_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x100cd4560;
T_1 ;
    %delay 1000, 0;
    %vpi_call/w 3 5 "$reg_start" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x100cd0ec0_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 6 "$reg_inspect" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 7 "$reg_admit" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x100cd0ec0_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 9 "$reg_replace" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x100cd0ec0_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 10 "$reg_inspect" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 11 "$reg_cancel" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x100cd0ec0_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 12 "$reg_inspect" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 13 "$reg_restart" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x100cd0ec0_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 14 "$reg_inspect" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 15 "$finish" {0 0 0};
    %end;
    .thread T_1;
