Autonomous HDL output timing control
Vin in 0 0
Ain [in] [din] adc
.model adc adc_bridge(in_low=0.8 in_high=2.0)
Ahdl [din] [dq] hdl
.model hdl d_cosim simulation="/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/bridge/ivlng.so" sim_args=["io.vvp"] delay=1n
+ lib_args=["/private/tmp/robotron-icarus-src/vvp/libvvp.so" "/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/rollback-time-bridge-postreset/ivlng.vpi"]
Aout [dq] [out] dac
.model dac dac_bridge(out_low=0 out_high=5 t_rise=1n t_fall=1n)
Rload out 0 1k
.save v(out)
.tran 10n 400n 0 80n
.control
set filetype=binary
run waveform.raw
quit
.endc
.end
