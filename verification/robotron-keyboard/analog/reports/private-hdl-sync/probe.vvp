#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x102e00e20 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x102e00fa0 .scope module, "probe" "probe" 3 2;
 .timescale -9 -12;
v0x102dfcea0_0 .var "clk", 0 0;
v0x102e014d0_0 .var "value", 0 0;
E_0xc0d028600 .event anyedge, v0x102e014d0_0, v0x102dfcea0_0;
    .scope S_0x102e00fa0;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102dfcea0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102e014d0_0, 0, 1;
    %end;
    .thread T_0, $init;
    .scope S_0x102e00fa0;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x102dfcea0_0;
    %inv;
    %store/vec4 v0x102dfcea0_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x102e00fa0;
T_2 ;
    %wait E_0xc0d028600;
    %vpi_call/w 3 6 "$display", "VALUE %0t %b %b", $time, v0x102dfcea0_0, v0x102e014d0_0 {0 0 0};
    %jmp T_2;
    .thread T_2, $push;
    .scope S_0x102e00fa0;
T_3 ;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x102e014d0_0, 7000;
    %delay 2000, 0;
    %vpi_call/w 3 9 "$queue_inventory" {0 0 0};
    %delay 10000, 0;
    %vpi_call/w 3 10 "$queue_inventory" {0 0 0};
    %delay 10000, 0;
    %vpi_call/w 3 11 "$queue_inventory" {0 0 0};
    %delay 4000, 0;
    %vpi_call/w 3 12 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x102e00fa0;
T_4 ;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x102e014d0_0, 8000;
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/private-sync-controls-final/probe.v";
