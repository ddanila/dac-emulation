.save v(receiver_data) v(receiver_clock) v(n_D0) v(n_D1) v(n_D2) v(n_D3) v(n_D4) v(n_D5) v(n_D6) v(n_D7) v(n_p5V) i(Vdriver_supply) v(n_WR_N) v(wr_low) v(wr_high) @bwr_low[i] @bwr_high[i] v(n_p5V) v(n_p5V) v(n_TA_TAKT) v(n_TA_DATEN) v(L1_1_series) v(L1_2_series) v(L1_3_series) v(L1_4_series) v(n_CABLE_TAKT) v(n_CABLE_GND) v(n_CABLE_5V) v(n_CABLE_DATEN) i(L1.1) i(L1.2) i(L1.3) i(L1.4) v(n_D0) v(n_WR_N) i(Vdriver_supply) @bwr_low[i] @bwr_high[i]
.control
set numdgt=17
set wr_singlescale
set wr_vecnames
run
wrdata witness.txt v(receiver_data) v(receiver_clock)
wrdata network_witness.txt v(n_p5V) v(n_TA_TAKT) v(n_TA_DATEN) v(L1_1_series) v(L1_2_series) v(L1_3_series) v(L1_4_series) v(n_CABLE_TAKT) v(n_CABLE_GND) v(n_CABLE_5V) v(n_CABLE_DATEN) i(L1.1) i(L1.2) i(L1.3) i(L1.4) v(n_D0) v(n_WR_N) i(Vdriver_supply) @bwr_low[i] @bwr_high[i]
wrdata bus-trace.txt v(n_D0) v(n_D1) v(n_D2) v(n_D3) v(n_D4) v(n_D5) v(n_D6) v(n_D7) v(n_p5V)
wrdata driver-trace.txt i(Vdriver_supply)
wrdata wr-trace.txt v(n_WR_N) v(wr_low) v(wr_high) @bwr_low[i] @bwr_high[i] v(n_p5V)
quit
.endc
.end
