:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1031fcd60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x103200ee0 .scope module, "probe" "probe" 3 2;
 .timescale -9 -12;
v0x1031fcee0_0 .var "a", 3 0;
    .scope S_0x103200ee0;
T_0 ;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x1031fcee0_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x103200ee0;
T_1 ;
    %delay 1000, 0;
    %vpi_call/w 3 5 "$list_watch" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x1031fcee0_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 7 "$list_cancel_middle" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x1031fcee0_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 8 "$list_inspect" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 9 "$list_cancel_head" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x1031fcee0_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 10 "$list_inspect" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 11 "$list_cancel_tail" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x1031fcee0_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 12 "$list_inspect" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 13 "$finish" {0 0 0};
    %end;
    .thread T_1;
