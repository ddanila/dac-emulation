#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x103a82c80 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x103a82e00 .scope module, "lifecycle" "lifecycle" 3 2;
 .timescale -9 -12;
S_0x103a8a2c0 .scope module, "empty" "scope_empty" 3 3, 3 25 0, S_0x103a82e00;
 .timescale -9 -12;
    .scope S_0x103a82e00;
T_0 ;
    %fork t_1, S_0x103a82e00;
    %fork t_2, S_0x103a82e00;
    %join/detach 2;
    %jmp t_0;
t_1 ;
    %delay 2000, 0;
    %vpi_call/w 3 6 "$display", "CHILD_A %0t", $time {0 0 0};
    %end;
t_2 ;
    %delay 4000, 0;
    %vpi_call/w 3 7 "$display", "CHILD_B %0t", $time {0 0 0};
    %end;
    .scope S_0x103a82e00;
t_0 ;
    %delay 1000, 0;
    %vpi_call/w 3 9 "$thread_observe" {0 0 0};
    %vpi_call/w 3 9 "$lifecycle_defer" {0 0 0};
    %wait/fork;
    %delay 1000, 0;
    %vpi_call/w 3 11 "$thread_observe" {0 0 0};
    %fork t_4, S_0x103a82e00;
    %fork t_5, S_0x103a82e00;
    %join/detach 2;
    %jmp t_3;
t_4 ;
    %delay 5000, 0;
    %vpi_call/w 3 13 "$display", "UNEXPECTED_A" {0 0 0};
    %end;
t_5 ;
    %delay 10000, 0;
    %vpi_call/w 3 14 "$display", "UNEXPECTED_B" {0 0 0};
    %end;
    .scope S_0x103a82e00;
t_3 ;
    %delay 1000, 0;
    %vpi_call/w 3 16 "$thread_observe" {0 0 0};
    %disable/fork;
    %vpi_call/w 3 18 "$thread_observe" {0 0 0};
    %delay 11000, 0;
    %vpi_call/w 3 19 "$thread_observe" {0 0 0};
    %vpi_call/w 3 20 "$display", "FINISHED %0t", $time {0 0 0};
    %vpi_call/w 3 20 "$finish" {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x103a82e00;
T_1 ;
    %delay 2000, 0;
    %vpi_call/w 3 22 "$lifecycle_defer" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/scope-admission-membership-controls/probe.v";
