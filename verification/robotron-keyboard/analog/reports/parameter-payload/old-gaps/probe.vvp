#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x100b88700 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x100b8d080 .scope module, "test" "test" 3 2;
 .timescale -9 -12;
P_0x100b89020 .param/l "P" 0 3 3, C4<0011>;
v0x100b8d200_0 .var/s "hidden", 3 0;
v0x100b8d670 .array "memory", 1 0, 7 0;
v0x100b8d720_0 .var/s "visible", 3 0;
    .scope S_0x100b8d080;
T_0 ;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x100b8d720_0, 0, 4;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x100b8d200_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x100b8d080;
T_1 ;
    %pushi/vec4 5, 0, 8;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x100b8d670, 4, 0;
    %pushi/vec4 7, 0, 8;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x100b8d670, 4, 0;
    %delay 1000, 0;
    %vpi_call/w 3 8 "$scope_payload_gaps" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 9 "$scope_payload_gaps" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 10 "$display", "CONTINUE %0d %0d %0d %0d", v0x100b8d720_0, v0x100b8d200_0, P_0x100b89020, &A<v0x100b8d670, 0> {0 0 0};
    %vpi_call/w 3 10 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/parameter-payload/old-gaps/probe.v";
