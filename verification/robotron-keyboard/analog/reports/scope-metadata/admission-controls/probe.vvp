S_0x102f74590 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x102f74710 .scope module, "test" "test" 3 3;
 .timescale -9 -12;
v0x102f78d50_0 .var "value", 3 0;
S_0x102f788f0 .scope module, "child" "leaf" 3 4, 3 2 0, S_0x102f74710;
 .timescale -9 -12;
v0x102f74ef0_0 .var "value", 3 0;
    .scope S_0x102f788f0;
T_0 ;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x102f74ef0_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x102f74710;
T_1 ;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x102f78d50_0, 0, 4;
    %end;
    .thread T_1, $init;
    .scope S_0x102f74710;
T_2 ;
    %delay 1000, 0;
    %vpi_call/w 3 7 "$scope_admission" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x102f78d50_0, 0, 4;
    %vpi_call/w 3 8 "$scope_admission" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 9 "$display", "CONTINUE %0d %0d", v0x102f78d50_0, v0x102f74ef0_0 {0 0 0};
    %vpi_call/w 3 9 "$finish" {0 0 0};
    %end;
    .thread T_2;
