#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x100f145b0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x100f14730 .scope module, "test" "test" 3 3;
 .timescale -9 -12;
v0x100f19e70_0 .var "value", 3 0;
S_0x100f197b0 .scope module, "child" "leaf" 3 4, 3 2 0, S_0x100f14730;
 .timescale -9 -12;
v0x100f14f30_0 .var "value", 3 0;
S_0x100f19b40 .scope function.vec4.s8, "identity" "identity" 3 5, 3 5 0, S_0x100f14730;
 .timescale -9 -12;
; Variable identity is vec4 return value of scope S_0x100f19b40
v0x100f19dc0_0 .var "x", 7 0;
TD_test.identity ;
    %load/vec4 v0x100f19dc0_0;
    %ret/vec4 0, 0, 8;  Assign to identity (store_vec4_to_lval)
    %end;
    .scope S_0x100f197b0;
T_1 ;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x100f14f30_0, 0, 4;
    %end;
    .thread T_1, $init;
    .scope S_0x100f14730;
T_2 ;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x100f19e70_0, 0, 4;
    %end;
    .thread T_2, $init;
    .scope S_0x100f14730;
T_3 ;
    %delay 1000, 0;
    %vpi_call/w 3 8 "$scope_metadata" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x100f19e70_0, 0, 4;
    %vpi_call/w 3 9 "$scope_metadata" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 10 "$display", "CONTINUE %0d %0d", v0x100f19e70_0, v0x100f14f30_0 {0 0 0};
    %vpi_call/w 3 10 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/scope-metadata-bindings/metadata-controls/probe.v";
