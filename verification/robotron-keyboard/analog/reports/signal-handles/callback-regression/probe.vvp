:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1017d0660 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1017d4040 .scope module, "test" "test" 3 2;
 .timescale -9 -12;
v0x1017d07e0_0 .var/s "left", 3 0;
v0x1017d4550_0 .var "right", 3 0;
    .scope S_0x1017d4040;
T_0 ;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x1017d07e0_0, 0, 4;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x1017d4550_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 7 "$referents" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x1017d07e0_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 9 "$display", "CONTINUE %0d %0d", v0x1017d07e0_0, v0x1017d4550_0 {0 0 0};
    %vpi_call/w 3 10 "$finish" {0 0 0};
    %end;
    .thread T_0;
