E_0x996c145c0 .event posedge, v0x100df9ab0_0;
S_0x100df98e0 .scope generate, "genblk4" "genblk4" 3 8, 3 8 0, S_0x100df9760;
 .timescale -12 -12;
E_0x996c14600 .event anyedge, v0x100df9ec0_0;
    .scope S_0x100df98e0;
T_0 ;
    %wait E_0x996c14600;
    %load/vec4 v0x100df9ec0_0;
    %assign/vec4 v0x100df9ab0_0, 0;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x100df9760;
T_1 ;
