:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1027b4950 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1027b4ad0 .scope module, "test" "test" 3 3;
 .timescale -9 -12;
v0x1027b8f30_0 .net "result", 3 0, L_0x1027b90b0;  1 drivers
v0x1027b8ff0_0 .var "value", 3 0;
S_0x1027b2c80 .scope module, "child" "leaf" 3 6, 3 2 0, S_0x1027b4ad0;
 .timescale -9 -12;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /OUTPUT 4 "b";
L_0x1027b90b0 .functor BUFZ 4, v0x1027b8ff0_0, C4<0000>, C4<0000>, C4<0000>;
v0x1027b2e00_0 .net "a", 3 0, v0x1027b8ff0_0;  1 drivers
v0x1027b8e80_0 .net "b", 3 0, L_0x1027b90b0;  alias, 1 drivers
    .scope S_0x1027b4ad0;
T_0 ;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x1027b8ff0_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x1027b4ad0;
T_1 ;
    %delay 1000, 0;
    %vpi_call/w 3 8 "$port_referents" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x1027b8ff0_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 9 "$port_referents" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 10 "$display", "CONTINUE %0d %0d", v0x1027b8ff0_0, v0x1027b8f30_0 {0 0 0};
    %vpi_call/w 3 10 "$finish" {0 0 0};
    %end;
    .thread T_1;
