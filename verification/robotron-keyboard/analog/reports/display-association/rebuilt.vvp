#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/private/tmp/k7658-display-association-v2/baseline/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x100d41750 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x100d418d0 .scope module, "probe" "probe" 3 2;
 .timescale -9 -12;
v0x100d3ce60_0 .var "first", 7 0;
v0x100d41b60_0 .var/i "i", 31 0;
v0x100d41c10_0 .var "second", 7 0;
    .scope S_0x100d418d0;
T_0 ;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x100d3ce60_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x100d41c10_0, 0, 8;
    %end;
    .thread T_0, $init;
    .scope S_0x100d418d0;
T_1 ;
    %vpi_call/w 3 6 "$timeformat", 32'sb11111111111111111111111111110111, 32'sb00000000000000000000000000000010, " ns", 32'sb00000000000000000000000000001000 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x100d41b60_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v0x100d41b60_0;
    %cmpi/s 3, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %delay 2000, 0;
    %pushi/vec4 160, 0, 32;
    %load/vec4 v0x100d41b60_0;
    %add;
    %pad/u 8;
    %store/vec4 v0x100d3ce60_0, 0, 8;
    %pushi/vec4 192, 0, 32;
    %load/vec4 v0x100d41b60_0;
    %add;
    %pad/u 8;
    %store/vec4 v0x100d41c10_0, 0, 8;
    %pushi/vec4 176, 0, 32;
    %load/vec4 v0x100d41b60_0;
    %add;
    %pad/u 8;
    %assign/vec4 v0x100d3ce60_0, 0;
    %pushi/vec4 208, 0, 32;
    %load/vec4 v0x100d41b60_0;
    %add;
    %pad/u 8;
    %assign/vec4 v0x100d41c10_0, 0;
    %vpi_call/w 3 10 "$strobe", "FIRST %0t %h", $time, v0x100d3ce60_0 {0 0 0};
    %vpi_call/w 3 11 "$strobe", "SECOND %0t %h", $time, v0x100d41c10_0 {0 0 0};
    %vpi_call/w 3 12 "$display_inventory" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 13 "$display_inventory" {0 0 0};
    %delay 7000, 0;
T_1.2 ; for-loop step statement
    %load/vec4 v0x100d41b60_0;
    %addi 1, 0, 32;
    %store/vec4 v0x100d41b60_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %vpi_call/w 3 16 "$finish" {0 0 0};
    %end;
    .thread T_1;
