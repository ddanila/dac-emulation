    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x104fa0f20, 4, 0;
    %vpi_call/w 3 8 "$array_admission" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 9 "$display", "CONTINUE %0d %0d %h %h", &A<v0x104fa0e80, 0>, &A<v0x104fa0e80, 1>, &A<v0x104fa0f20, 0>, &A<v0x104fa0f20, 1> {0 0 0};
    %vpi_call/w 3 9 "$finish" {0 0 0};
    %end;
    .thread T_0;
