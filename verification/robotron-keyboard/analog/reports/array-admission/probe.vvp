    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x104fa0f20, 4, 0;
    %delay 1000, 0;
    %vpi_call/w 3 7 "$array_admission" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 2147483648, 0, 35;
