#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1018dc010 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1018dc190 .scope module, "test" "test" 3 2;
 .timescale -9 -12;
v0x1018d8760 .array "memory", 1 0, 7 0;
    .scope S_0x1018dc190;
T_0 ;
    %pushi/vec4 17, 0, 8;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x1018d8760, 4, 0;
    %pushi/vec4 34, 0, 8;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x1018d8760, 4, 0;
    %delay 1000, 0;
    %vpi_call/w 3 6 "$memory_lifecycle" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 7 "$memory_lifecycle" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 8 "$display", "CONTINUE %0d %0d", &A<v0x1018d8760, 0>, &A<v0x1018d8760, 1> {0 0 0};
    %vpi_call/w 3 8 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/parameter-lifecycle-memory/probe.v";
