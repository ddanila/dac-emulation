:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x105080c90 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x105080e10 .scope module, "array_family" "array_family" 3 2;
 .timescale -9 -12;
v0x105085190_0 .array/port v0x105085190, 0;
L_0x105085420 .functor BUFZ 8, v0x105085190_0, C4<00000000>, C4<00000000>, C4<00000000>;
v0x105085190 .array "memory", 3 0, 7 0;
v0x105085350 .array "other", 3 0;
v0x105085350_0 .net v0x105085350 0, 7 0, L_0x105085420; 1 drivers
o0x98b420100 .functor BUFZ 8, c4<zzzzzzzz>; HiZ drive
v0x105085350_1 .net v0x105085350 1, 7 0, o0x98b420100; 0 drivers
o0x98b420130 .functor BUFZ 8, c4<zzzzzzzz>; HiZ drive
v0x105085350_2 .net v0x105085350 2, 7 0, o0x98b420130; 0 drivers
o0x98b420160 .functor BUFZ 8, c4<zzzzzzzz>; HiZ drive
v0x105085350_3 .net v0x105085350 3, 7 0, o0x98b420160; 0 drivers
    .scope S_0x105080e10;
T_0 ;
    %pushi/vec4 165, 0, 8;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x105085190, 4, 0;
    %delay 1000, 0;
    %vpi_call/w 3 23 "$family_check" {0 0 0};
    %vpi_call/w 3 24 "$family_observe" {0 0 0};
    %vpi_call/w 3 25 "$display", "CONTINUED %0t", $time {0 0 0};
    %vpi_call/w 3 26 "$finish" {0 0 0};
    %end;
    .thread T_0;
