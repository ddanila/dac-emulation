#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1048b0370 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1048b04f0 .scope module, "test" "test" 3 2;
 .timescale -9 -12;
S_0x1048b0670 .scope autotask, "local_task" "local_task" 3 3, 3 3 0, S_0x1048b04f0;
 .timescale -9 -12;
v0x1048acf50_0 .var "value", 0 0;
TD_test.local_task ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1048acf50_0, 0, 1;
    %end;
    .scope S_0x1048b04f0;
T_1 ;
    %alloc S_0x1048b0670;
    %fork TD_test.local_task, S_0x1048b0670;
    %join;
    %free S_0x1048b0670;
    %delay 1000, 0;
    %vpi_call/w 3 4 "$scope_metadata_refuse" {0 0 0};
    %vpi_call/w 3 4 "$display", "CONTINUE automatic" {0 0 0};
    %vpi_call/w 3 4 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/scope-metadata-compact/unsupported.v";
