#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x100f5cd60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x100f61810 .scope module, "probe" "probe" 3 2;
 .timescale -9 -12;
v0x100f5cee0_0 .var "a", 3 0;
v0x100f61cd0_0 .var "b", 3 0;
    .scope S_0x100f61810;
T_0 ;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x100f5cee0_0, 0, 4;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x100f61cd0_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x100f61810;
T_1 ;
    %delay 1000, 0;
    %vpi_call/w 3 5 "$value_watch" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x100f5cee0_0, 0, 4;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x100f61cd0_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 7 "$value_observe" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x100f5cee0_0, 0, 4;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x100f61cd0_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 9 "$value_cancel" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x100f5cee0_0, 0, 4;
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x100f61cd0_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 11 "$value_retired" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 12 "$value_cancel_head" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x100f5cee0_0, 0, 4;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x100f61cd0_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 14 "$value_retired_head" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 15 "$finish" {0 0 0};
    %end;
    .thread T_1;
