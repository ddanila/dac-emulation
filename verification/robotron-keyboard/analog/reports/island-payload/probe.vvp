#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x105018580 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x105018700 .scope module, "probe" "probe" 3 2;
 .timescale -9 -12;
L_0x10501f660 .functor BUFZ 4 [3 3], v0x10501f5c0_0, C4<0000>, C4<0000>, C4<0000>;
I0x105018d40 .island tran;
p0xb11420010 .import I0x105018d40, L_0x10501f7a0;
v0x10501d5f0_0 .net *"_ivl_5", 3 0, L_0x10501f7a0;  1 drivers
p0xb11420040 .port I0x105018d40, v0x10501f520_0;
v0x10501d210_0 .net8 "a", 3 0, p0xb11420040;  1 drivers, strength-aware
p0xb11420070 .port I0x105018d40, L_0x10501f660;
v0x10501f3e0_0 .net8 "b", 3 0, p0xb11420070;  1 drivers, strength-aware
v0x10501f480_0 .var "enable", 0 0;
v0x10501f520_0 .var "left", 3 0;
v0x10501f5c0_0 .var "right", 3 0;
L_0x10501f7a0 .repeat 4, 4, v0x10501f480_0;
 .tranif1 I0x105018d40, p0xb11420040 p0xb11420070, p0xb11420010;
    .scope S_0x105018700;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x10501f480_0, 0, 1;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x10501f520_0, 0, 4;
    %pushi/vec4 0, 15, 4;
    %store/vec4 v0x10501f5c0_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x105018700;
T_1 ;
    %vpi_call/w 3 9 "$monitor", "CHANGE %0t %b %b %b", $time, v0x10501f480_0, v0x10501d210_0, v0x10501f3e0_0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x105018700;
T_2 ;
    %delay 1000, 0;
    %vpi_call/w 3 11 "$island_observe" {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x10501f480_0, 0, 1;
    %delay 1000, 0;
    %vpi_call/w 3 13 "$island_observe" {0 0 0};
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x10501f5c0_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 15 "$island_observe" {0 0 0};
    %pushi/vec4 1, 1, 1;
    %store/vec4 v0x10501f480_0, 0, 1;
    %delay 1000, 0;
    %vpi_call/w 3 17 "$island_observe" {0 0 0};
    %pushi/vec4 0, 15, 4;
    %store/vec4 v0x10501f520_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 19 "$island_observe" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x10501f480_0, 0, 1;
    %delay 1000, 0;
    %vpi_call/w 3 21 "$island_observe" {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x10501f480_0, 0, 1;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x10501f520_0, 0, 4;
    %delay 1000, 0;
    %vpi_call/w 3 23 "$island_observe" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 24 "$finish" {0 0 0};
    %end;
    .thread T_2;
