#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1026acb60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1026acce0 .scope module, "wait_unsupported" "wait_unsupported" 3 2;
 .timescale -9 -12;
v0x1026a6e50_0 .var "clk", 0 0;
v0x1026ad230_0 .var "value", 7 0;
E_0x1026a7200 .event posedge, v0x1026a6e50_0;
    .scope S_0x1026acce0;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1026a6e50_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x1026ad230_0, 0, 8;
    %end;
    .thread T_0, $init;
    .scope S_0x1026acce0;
T_1 ;
    %evctl/i E_0x1026a7200, 3;
    %pushi/vec4 90, 0, 8;
    %assign/vec4/e v0x1026ad230_0;
    %evctl/c;
    %delay 1000, 0;
    %vpi_call/w 3 7 "$wait_observe" {0 0 0};
    %vpi_call/w 3 8 "$display", "CONTINUED %0t", $time {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x1026acce0;
T_2 ;
    %delay 1000, 0;
    %load/vec4 v0x1026a6e50_0;
    %inv;
    %store/vec4 v0x1026a6e50_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x1026acce0;
T_3 ;
    %delay 7000, 0;
    %vpi_call/w 3 12 "$display", "RESULT %0t %h", $time, v0x1026ad230_0 {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 13 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/Users/ddanila/fun/dac-emulation/build/keyboard-controller-analog/wait-unsupported-probe/probe.v";
