v0x104ec5a60_0 .var "value", 3 0;
S_0x104ec0550 .scope module, "child" "leaf" 3 6, 3 2 0, S_0x104ec1340;
 .timescale -9 -12;
    .port_info 0 /INPUT 4 "a" L_0x104ec5b00;
    .port_info 1 /OUTPUT 4 "b" L_0x104ec5b70;
L_0x104ec0810 .functor BUFZ 4, L_0x104ec5b00, C4<0000>, C4<0000>, C4<0000>;
L_0x104ec5b00 .functor BUFT 4, v0x104ec5a60_0, C4<0000>, C4<0000>, C4<0000>;
