v0x104ec06d0_0 .net "b", 3 0, L_0x104ec0810;  1 drivers
    .scope S_0x104ec1340;
T_0 ;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x104ec5a60_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x104ec1340;
T_1 ;
    %delay 1000, 0;
    %vpi_call/w 3 8 "$port_payload_faults" {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x104ec5a60_0, 0, 4;
    %delay 0, 0;
    %vpi_call/w 3 9 "$port_payload_faults" {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 10 "$display", "CONTINUE %0d %0d", v0x104ec5a60_0, v0x104ec0770_0 {0 0 0};
    %vpi_call/w 3 10 "$finish" {0 0 0};
    %end;
    .thread T_1;
