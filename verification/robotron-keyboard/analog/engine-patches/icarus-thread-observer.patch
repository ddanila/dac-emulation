+static int robotron_thread_vector(FILE* out,const vvp_vector4_t& value)
+{
+    if(fprintf(out,"VT_VEC %u ",value.size())<0)return -1;
+    if(!value.size() && fputc('-',out)==EOF)return -1;
+    for(unsigned i=0;i<value.size();++i)if(fputc('0'+(unsigned)value.value(i),out)==EOF)return -1;
+    return fputc('\n',out)==EOF?-1:0;
+}
+int vthread_s::robotron_inventory(FILE* out) const
+{
+    auto id=robotron_thread_id(const_cast<vthread_s*>(this));
+    if(!id || (parent && !robotron_thread_id(parent)) || (wait_next && !robotron_thread_id(wait_next)))return -1;
+    if(fprintf(out,"VT_THREAD %llu %p %p %llu %llu %p %p %p %llu\n",id,(void*)pc,(void*)parent_scope,
+               robotron_thread_id(parent),robotron_thread_id(wait_next),wt_context,rd_context,(void*)event,(unsigned long long)ecount)<0)return -1;
+    if(fprintf(out,"VT_STATE %u%u%u%u%u%u%u%u%u\n",i_am_joining,i_am_detached,i_am_waiting,i_am_in_function,
+               i_have_ended,i_was_disabled,waiting_for_event,is_scheduled,delay_delete)<0)return -1;
+    if(fprintf(out,"VT_FLAGS %u ",(unsigned)FLAGS_COUNT)<0)return -1;
+    for(unsigned i=0;i<FLAGS_COUNT;++i)if(fputc(robotron_flags_valid[i]?'0'+(unsigned)flags[i]:'-',out)==EOF)return -1;
+    if(fprintf(out,"\nVT_WORDS %u",(unsigned)WORDS_COUNT)<0)return -1;
+    for(unsigned i=0;i<WORDS_COUNT;++i){
+        if(!robotron_words_valid[i]){if(fprintf(out," -")<0)return -1;}
+        else if(fprintf(out," %016llx",(unsigned long long)robotron_word_read<uint64_t>(i))<0)return -1;
+    }
+    if(fputc('\n',out)==EOF)return -1;
+    const set<vthread_s*>* sets[]={&children,&detached_children};
+    for(unsigned k=0;k<2;++k){
+        set<unsigned long long> ids;
+        for(auto child:*sets[k]){auto value=robotron_thread_id(child);if(!value)return -1;ids.insert(value);}
+        if(fprintf(out,"VT_CHILDREN %u %zu",k,ids.size())<0)return -1;
+        for(auto value:ids)if(fprintf(out," %llu",value)<0)return -1;
+        if(fputc('\n',out)==EOF)return -1;
+    }
+    const vector<unsigned>* args[]={&args_real,&args_str,&args_vec4};
+    for(unsigned k=0;k<3;++k){
+        if(fprintf(out,"VT_ARGS %u %zu",k,args[k]->size())<0)return -1;
+        for(auto value:*args[k])if(fprintf(out," %u",value)<0)return -1;
+        if(fputc('\n',out)==EOF)return -1;
+    }
+    if(fprintf(out,"VT_STACKS %zu %zu %zu %u\n",stack_vec4_.size(),stack_real_.size(),stack_str_.size(),stack_obj_size_)<0)return -1;
+    for(const auto& value:stack_vec4_)if(robotron_thread_vector(out,value))return -1;
+    for(double value:stack_real_){uint64_t bits;static_assert(sizeof(bits)==sizeof(value),"Unexpected real size");memcpy(&bits,&value,sizeof(bits));
+        if(fprintf(out,"VT_REAL %016llx\n",(unsigned long long)bits)<0)return -1;}
+    for(const auto& value:stack_str_){
+        if(fprintf(out,"VT_STRING %zu ",value.size())<0)return -1;
+        if(value.empty() && fputc('-',out)==EOF)return -1;
+        for(unsigned char c:value)if(fprintf(out,"%02x",(unsigned)c)<0)return -1;
+        if(fputc('\n',out)==EOF)return -1;
+    }
+    for(unsigned i=0;i<stack_obj_size_;++i)if(fprintf(out,"VT_OBJECT %p\n",(void*)stack_obj_[i].peek<vvp_object>())<0)return -1;
+    if(fprintf(out,"VT_SOURCE %u ",lineno_)<0)return -1;
+    if(!filenm_){if(fputc('-',out)==EOF)return -1;}
+    else for(const unsigned char* p=(const unsigned char*)filenm_;*p;++p)if(fprintf(out,"%02x",(unsigned)*p)<0)return -1;
+    return fputc('\n',out)==EOF || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_thread_inventory(FILE* out)
+{
+    if(!out || (running_thread && !robotron_thread_id(running_thread)))return -1;
+    if(fprintf(out,"VT_BEGIN 1 %llu %llu\n",(unsigned long long)schedule_simtime(),robotron_thread_id(running_thread))<0)return -1;
+    map<unsigned long long,vthread_t> ordered;
+    for(const auto& item:robotron_threads())ordered[item.second]=item.first;
+    for(const auto& item:ordered)if(item.second->robotron_inventory(out))return -1;
+    return fprintf(out,"VT_END %zu\n",ordered.size())<0 || ferror(out)?-1:0;
+}
+int vthread_s::robotron_toggle(int field)
+{
+    static vthread_s* saved=0;static int saved_field;static unsigned index;
+    static unsigned scheduled;static vvp_bit4_t flag;static uint64_t word;static vvp_code_t code;static vthread_t next;
+    static vvp_vector4_t vector;static uint64_t real_bits;static string text;
+    if(saved){
+        if(saved!=this || saved_field!=field)return -1;
+        if(field==0)is_scheduled=scheduled;
+        else if(field==1)flags[index]=flag;
+        else if(field==2)memcpy(&words[index],&word,sizeof(word));
+        else if(field==3)pc=code;
+        else if(field==4)wait_next=next;
+        else if(field==5)stack_vec4_[0]=vector;
+        else if(field==6)memcpy(&stack_real_[0],&real_bits,sizeof(real_bits));
+        else stack_str_[0]=text;
+        saved=0;return 1;
+    }
+    if(field<0 || field>7)return -1;
+    if((field==5 && (stack_vec4_.empty() || !stack_vec4_[0].size())) || (field==6 && stack_real_.empty()) || (field==7 && stack_str_.empty()))return 0;
+    if(field==1){for(index=0;index<FLAGS_COUNT && !robotron_flags_valid[index];++index){}if(index==FLAGS_COUNT)return 0;}
+    if(field==2){for(index=0;index<WORDS_COUNT && !robotron_words_valid[index];++index){}if(index==WORDS_COUNT)return 0;}
+    saved=this;saved_field=field;
+    if(field==0){scheduled=is_scheduled;is_scheduled^=1;}
+    else if(field==1){flag=flags[index];flags[index]=flag==BIT4_1?BIT4_0:BIT4_1;}
+    else if(field==2){word=robotron_word_read<uint64_t>(index);uint64_t changed=word^1;memcpy(&words[index],&changed,sizeof(changed));}
+    else if(field==3){code=pc;pc=0;}
+    else if(field==4){next=wait_next;wait_next=wait_next?0:this;}
+    else if(field==5){vector=stack_vec4_[0];stack_vec4_[0].set_bit(0,vector.value(0)==BIT4_1?BIT4_0:BIT4_1);}
+    else if(field==6){memcpy(&real_bits,&stack_real_[0],sizeof(real_bits));uint64_t changed=real_bits^1;memcpy(&stack_real_[0],&changed,sizeof(changed));}
+    else{text=stack_str_[0];stack_str_[0]+="A";}
+    return 1;
+}
+extern "C" int robotron_vvp_thread_toggle(int field)
+{
+    static vthread_t saved=0;static unsigned long long identity;static int saved_field;
+    if(saved){
+        if(robotron_thread_id(saved)!=identity || saved_field!=field)return -1;
+        int r=saved->robotron_toggle(field);if(r==1)saved=0;return r;
+    }
+    map<unsigned long long,vthread_t> ordered;
+    for(const auto& item:robotron_threads())ordered[item.second]=item.first;
+    for(const auto& item:ordered){int r=item.second->robotron_toggle(field);if(r<0)return r;
+        if(r){saved=item.second;identity=item.first;saved_field=field;return 1;}}
+    return 0;
+}
