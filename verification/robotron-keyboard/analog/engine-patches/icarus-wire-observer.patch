+static int robotron_wire_vector4(FILE* out,const char* name,const vvp_vector4_t& value)
+{
+    if(fprintf(out,"VIF_VECTOR %s %u ",name,value.size())<0)return -1;
+    if(!value.size() && fputc('-',out)==EOF)return -1;
+    for(unsigned bit=0;bit<value.size();++bit)if(fputc('0'+(unsigned)value.value(bit),out)==EOF)return -1;
+    return fputc('\n',out)==EOF?-1:0;
+}
+int vvp_wire_vec4::robotron_wire_inventory(FILE* out) const
+{
+    if(fprintf(out,"VIF_WIRE %u\n",(unsigned)needs_init_)<0 || robotron_filter_inventory(out))return -1;
+    return robotron_wire_vector4(out,"driven",bits4_) || robotron_wire_vector4(out,"forced",force4_)?-1:0;
+}
+int vvp_wire_vec4::robotron_wire_toggle(int field)
+{
+    if(field>=3 && field<=5)return robotron_filter_toggle(field);
+    static vvp_wire_vec4* saved=0;static int saved_field;static bool init;static vvp_vector4_t vector;
+    if(saved){
+        if(saved!=this || saved_field!=field)return -1;
+        if(field==0)needs_init_=init;else if(field==2)force4_=vector;else bits4_=vector;
+        saved=0;return 1;
+    }
+    if(field<0 || field>2)return -1;
+    auto value=field==2?&force4_:&bits4_;
+    if(field!=0 && !value->size())return 0;
+    saved=this;saved_field=field;
+    if(field==0){init=needs_init_;needs_init_=!needs_init_;}
+    else{vector=*value;value->set_bit(0,value->value(0)==BIT4_1?BIT4_0:BIT4_1);}
+    return 1;
+}
