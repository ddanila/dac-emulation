+extern "C" int robotron_vvp_wire_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations()){
+        if(item.first->fil && !dynamic_cast<vvp_wire_vec4*>(item.first->fil) && !dynamic_cast<vvp_wire_vec8*>(item.first->fil))return -1;
+        nodes[item.second]=item.first;
+    }
+    if(fprintf(out,"VWF_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    unsigned count=0;
+    for(auto item:nodes){auto node=item.second;if(!node->fil)continue;
+        auto four=dynamic_cast<vvp_wire_vec4*>(node->fil);auto eight=dynamic_cast<vvp_wire_vec8*>(node->fil);
+        if(fprintf(out,"VWF_FILTER %llu %p %p %u\n",item.first,(void*)node,(void*)node->fil,four?4:8)<0 || node->fil->robotron_callback_heads(out))return -1;
+        if(four?four->robotron_wire_inventory(out):eight->robotron_wire_inventory(out))return -1;
+        ++count;
+    }
+    return fprintf(out,"VWF_END %u\n",count)<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_wire_toggle(int kind,int field)
+{
+    static vvp_net_fil_t* saved=0;static int saved_kind=-1,saved_field=-1;
+    if((kind!=4 && kind!=8) || field<0 || field>(kind==4?5:6) || (saved && (kind!=saved_kind || field!=saved_field)))return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations())nodes[item.second]=item.first;
+    for(auto item:nodes){auto filter=item.second->fil;if(!filter || (saved && saved!=filter))continue;
+        auto four=dynamic_cast<vvp_wire_vec4*>(filter);auto eight=dynamic_cast<vvp_wire_vec8*>(filter);
+        if((kind==4 && !four) || (kind==8 && !eight))continue;
+        int result=kind==4?four->robotron_wire_toggle(field):eight->robotron_wire_toggle(field);
+        if(result<0)return result;
+        if(result){saved=saved?0:filter;saved_kind=kind;saved_field=field;return 1;}
+    }
+    return saved?-1:0;
+}
