+int vvp_fun_concat::robotron_concat_inventory(FILE* out) const
+{
+    if(fprintf(out,"%p %u %u %u %u %u ",(void*)net_,wid_[0],wid_[1],wid_[2],wid_[3],val_.size())<0)return -1;
+    if(!val_.size() && fputc('-',out)==EOF)return -1;
+    for(unsigned i=0;i<val_.size();i++){if(fputc('0'+(unsigned)val_.value(i),out)==EOF)return -1;}
+    return fputc('\n',out)==EOF || ferror(out)?-1:0;
+}
+int vvp_fun_concat::robotron_concat_toggle(int field)
+{
+    static vvp_fun_concat* saved=0;static int saved_field;static vvp_vector4_t old;
+    static unsigned width;static vvp_net_t* pending;
+    if(field<0 || field>6)return -1;
+    if(saved){
+        if(saved!=this || field!=saved_field)return -1;
+        if(field==0 || field==6)val_=old;else if(field==5)net_=pending;else wid_[field-1]=width;
+        saved=0;return 1;
+    }
+    if(field==6)return 0;
+    if((field==0 && !val_.size()) || (field==5 && !net_))return 0;
+    if(field==0){old=val_;val_.set_bit(0,val_.value(0)==BIT4_1?BIT4_0:BIT4_1);}
+    else if(field==5){pending=net_;net_=nullptr;}
+    else{width=wid_[field-1];wid_[field-1]^=1;}
+    saved=this;saved_field=field;return 1;
+}
+
+int vvp_fun_concat8::robotron_concat_inventory(FILE* out) const
+{
+    if(fprintf(out,"%p %u %u %u %u %u ",(void*)net_,wid_[0],wid_[1],wid_[2],wid_[3],val_.size())<0)return -1;
+    if(!val_.size() && fputc('-',out)==EOF)return -1;
+    for(unsigned i=0;i<val_.size();i++){vvp_scalar_t bit=val_.value(i);unsigned char byte;static_assert(sizeof(bit)==1,"Raw scalar padding");memcpy(&byte,&bit,1);if(fprintf(out,"%02x",byte)<0)return -1;}
+    return fputc('\n',out)==EOF || ferror(out)?-1:0;
+}
+int vvp_fun_concat8::robotron_concat_toggle(int field)
+{
+    static vvp_fun_concat8* saved=0;static int saved_field;static vvp_vector8_t old;
+    static unsigned width;static vvp_net_t* pending;
+    if(field<0 || field>6)return -1;
+    if(saved){
+        if(saved!=this || field!=saved_field)return -1;
+        if(field==0 || field==6)val_=old;else if(field==5)net_=pending;else wid_[field-1]=width;
+        saved=0;return 1;
+    }
+    if(field==6){
+      for(unsigned i=0;i<val_.size();i++){
+        auto bit=val_.value(i);unsigned char byte;memcpy(&byte,&bit,1);
+        if(byte!=0 && byte!=136)continue;
+        old=val_;val_.set_bit(i,byte==0?vvp_scalar_t(BIT4_1,1,0):vvp_scalar_t());saved=this;saved_field=field;return 1;
+      }
+      return 0;
+    }
+    if((field==0 && !val_.size()) || (field==5 && !net_))return 0;
+    if(field==0){old=val_;unsigned char byte;auto bit=val_.value(0);memcpy(&byte,&bit,1);val_.set_bit(0,byte==0xee?vvp_scalar_t(BIT4_0,6,6):vvp_scalar_t(BIT4_1,6,6));}
+    else if(field==5){pending=net_;net_=nullptr;}
+    else{width=wid_[field-1];wid_[field-1]^=1;}
+    saved=this;saved_field=field;return 1;
+}
