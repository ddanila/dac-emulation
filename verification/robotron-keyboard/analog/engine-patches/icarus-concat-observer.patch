+#include "concat.h"
+static int robotron_concat_kind(vvp_net_fun_t* fun)
+{
+    if(!fun)return 0;
+    if(typeid(*fun)==typeid(vvp_fun_concat))return 4;
+    if(typeid(*fun)==typeid(vvp_fun_concat8))return 8;
+    return dynamic_cast<vvp_fun_concat*>(fun) || dynamic_cast<vvp_fun_concat8*>(fun)?-1:0;
+}
+extern "C" int robotron_vvp_concat_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;std::vector<const void*> keys;
+    for(auto item:robotron_net_allocations()){
+        int kind=robotron_concat_kind(item.first->fun);if(kind<0)return -1;
+        if(kind)nodes[item.second]=item.first;
+    }
+    if(fprintf(out,"VCN_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:nodes){
+        auto fun=item.second->fun;int kind=robotron_concat_kind(fun);
+        const void* key=kind==4?static_cast<vvp_fun_concat*>(fun)->robotron_event_key():static_cast<vvp_fun_concat8*>(fun)->robotron_event_key();keys.push_back(key);
+        if(fprintf(out,"VCN_NODE %llu %p %p %d %p ",item.first,(void*)item.second,(void*)fun,kind,key)<0)return -1;
+        int result=kind==4?static_cast<vvp_fun_concat*>(fun)->robotron_concat_inventory(out):static_cast<vvp_fun_concat8*>(fun)->robotron_concat_inventory(out);
+        if(result)return -1;
+    }
+    unsigned events=0;if(robotron_vvp_mux_queue(out,keys.data(),keys.size(),&events))return -1;
+    return fprintf(out,"VCN_END %zu %u\n",nodes.size(),events)<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_concat_toggle(unsigned long long id,int field)
+{
+    for(auto item:robotron_net_allocations())if(item.second==id){
+        auto fun=item.first->fun;int kind=robotron_concat_kind(fun);
+        if(kind==4)return static_cast<vvp_fun_concat*>(fun)->robotron_concat_toggle(field);
+        if(kind==8)return static_cast<vvp_fun_concat8*>(fun)->robotron_concat_toggle(field);
+        return -1;
+    }
+    return -1;
+}
