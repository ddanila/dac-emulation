+int vvp_fun_signal4_sa::robotron_signal_inventory(FILE* out) const
+{
+    if(fprintf(out,"%u %u %p %u ",(unsigned)needs_init_,(unsigned)continuous_assign_active_,(void*)cassign_link,bits4_.size())<0)return -1;
+    if(!bits4_.size()){if(fputc('-',out)==EOF)return -1;}
+    for(unsigned i=0;i<bits4_.size();i++)if(fputc('0'+(unsigned)bits4_.value(i),out)==EOF)return -1;
+    if(fprintf(out," %u ",assign_mask_.size())<0)return -1;
+    if(!assign_mask_.size()){if(fputc('-',out)==EOF)return -1;}
+    for(unsigned i=0;i<assign_mask_.size();i++)if(fputc('0'+assign_mask_.value(i),out)==EOF)return -1;
+    return fputc('\n',out)==EOF?-1:0;
+}
+int vvp_fun_signal4_sa::robotron_signal_toggle(int field)
+{
+    static vvp_fun_signal4_sa* saved=0;static int saved_field;
+    static bool init,active;static vvp_vector4_t bits;static vvp_vector2_t mask;static vvp_net_t* link;
+    if(saved){
+        if(saved!=this || saved_field!=field)return -1;
+        if(field==0)needs_init_=init;
+        else if(field==1)bits4_=bits;
+        else if(field==2)assign_mask_=mask;
+        else if(field==3)cassign_link=link;
+        else if(field==4)continuous_assign_active_=active;
+        saved=0;return 1;
+    }
+    if(field<0 || field>4)return -1;
+    if((field==1 && !bits4_.size()) || (field==2 && !assign_mask_.size()) || (field==3 && !cassign_link))return 0;
+    saved=this;saved_field=field;
+    if(field==0){init=needs_init_;needs_init_=!needs_init_;}
+    else if(field==1){bits=bits4_;bits4_.set_bit(0,bits4_.value(0)==BIT4_1?BIT4_0:BIT4_1);}
+    else if(field==2){mask=assign_mask_;assign_mask_.set_bit(0,!assign_mask_.value(0));}
+    else if(field==3){link=cassign_link;cassign_link=0;}
+    else{active=continuous_assign_active_;continuous_assign_active_=!continuous_assign_active_;}
+    return 1;
+}
