+extern "C" int robotron_vvp_signal_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations()){
+        auto base=dynamic_cast<vvp_fun_signal_base*>(item.first->fun);
+        if(base && !dynamic_cast<vvp_fun_signal4_sa*>(base))return -1;
+        if(base)nodes[item.second]=item.first;
+    }
+    if(fprintf(out,"VSG_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:nodes){
+        auto signal=dynamic_cast<vvp_fun_signal4_sa*>(item.second->fun);
+        if(fprintf(out,"VSG_SIGNAL %llu %p %p ",item.first,(void*)item.second,(void*)signal)<0 || signal->robotron_signal_inventory(out))return -1;
+    }
+    return fprintf(out,"VSG_END %zu\n",nodes.size())<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_signal_toggle(int field)
+{
+    static vvp_fun_signal4_sa* saved=0;static int saved_field=-1;
+    if(field<0 || field>4 || (saved && saved_field!=field))return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations())nodes[item.second]=item.first;
+    for(auto item:nodes){
+        auto signal=dynamic_cast<vvp_fun_signal4_sa*>(item.second->fun);
+        if(!signal || (saved && saved!=signal))continue;
+        int result=signal->robotron_signal_toggle(field);
+        if(result<0)return result;
+        if(result){saved=saved?0:signal;saved_field=field;return 1;}
+    }
+    return saved?-1:0;
+}
