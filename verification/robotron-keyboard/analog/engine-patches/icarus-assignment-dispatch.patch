+/* Track scheduler dispatch independently of virtual overrides. A subclass
+ * need not call its base run_run, so base-entry tracking alone is insufficient. */
+struct robotron_dispatch_frame {
+    event_s* event;
+    robotron_dispatch_frame* previous;
+};
+static robotron_dispatch_frame* robotron_dispatch_executing;
+static void robotron_dispatch_event(event_s* event)
+{
+    robotron_dispatch_frame frame={event,robotron_dispatch_executing};
+    robotron_dispatch_executing=&frame;
+    event->run_run();
+    robotron_dispatch_executing=frame.previous;
+}
