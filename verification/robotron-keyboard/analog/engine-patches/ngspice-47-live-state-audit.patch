+/* Read-only audit in external equation order; called before factorization. */
+void SMPauditLinearLoad(SMPmatrix *external, double *rhs, unsigned long serial,
+                       double time, double delta, int iteration, int order, double gmin)
+{
+    MatrixPtr matrix = external->SPmatrix;
+    int col;
+    fprintf(stderr, "LINEAR_AUDIT begin id=%lu time=%a delta=%a iteration=%d order=%d size=%d external=%d gmin=%a\n",
+        serial, time, delta, iteration, order,
+        matrix->Size, matrix->ExtSize, gmin);
+    for (col = 1; col <= matrix->Size; ++col) {
+        ElementPtr element;
+        for (element = matrix->FirstInCol[col]; element; element = element->NextInCol) {
+            if (element->Real != 0.0)
+                fprintf(stderr, "LINEAR_AUDIT a id=%lu row=%d col=%d value=%a\n", serial,
+                    matrix->IntToExtRowMap[element->Row], matrix->IntToExtColMap[element->Col], element->Real);
+        }
+    }
+    for (col = 1; col <= matrix->ExtSize; ++col)
+        fprintf(stderr, "LINEAR_AUDIT b id=%lu row=%d value=%a\n", serial, col, rhs[col]);
+}
