+/* Read-only Sparse audit, before factorization and immediately after solve. */
+static unsigned long audit_linear_load(CKTcircuit *ckt, int iteration, int maxIter)
+{
+    static unsigned long serial = 0;
+    CKTnode *node;
+    if (!(getenv("ROBOTRON_STATE_AUDIT") &&
+          (ckt->CKTtime > .001005011 &&
+           ckt->CKTtime < .001005014) &&
+          (iteration <= 10 || iteration % 100 == 0 || iteration > maxIter)))
+        return 0;
+    ++serial;
+    SMPauditLinearLoad(ckt->CKTmatrix, ckt->CKTrhs, serial, ckt->CKTtime, ckt->CKTdelta, iteration, ckt->CKTorder, ckt->CKTdiagGmin);
+    for (node = ckt->CKTnodes; node; node = node->next)
+        fprintf(stderr, "LINEAR_AUDIT name id=%lu index=%d name=%s\n", serial, node->number, node->name);
+    return serial;
+}
 
