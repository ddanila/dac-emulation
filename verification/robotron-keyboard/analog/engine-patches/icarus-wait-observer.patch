+// Observe logical initialized event state without invoking allocating receive helpers.
+static std::map<waitable_hooks_s*,unsigned long long>& robotron_wait_registry()
+{ static std::map<waitable_hooks_s*,unsigned long long> r; return r; }
+static unsigned long long robotron_wait_next=0;
+void robotron_wait_register(waitable_hooks_s*p) { robotron_wait_registry()[p]=++robotron_wait_next; }
+void robotron_wait_unregister(waitable_hooks_s*p) { robotron_wait_registry().erase(p); }
+extern "C" unsigned long long robotron_vvp_thread_identity(vthread_t);
+
+class RobotronWaitObserver {
+public:
+ struct Frame {
+  waitable_hooks_s*owner; unsigned long long id; unsigned kind;
+  vvp_context_t context; vthread_t*head; vvp_fun_edge::edge_t*mask;
+  vvp_bit4_t*bits; anyedge_value**values; void*referent;
+ };
+ static int frames(std::vector<Frame>&out) {
+  for(auto entry:robotron_wait_registry()) {
+   Frame f={entry.first,entry.second,0,0,0,0,0,0,0};
+   __vpiScope*scope=0;unsigned index=0;
+   if(auto p=dynamic_cast<vvp_fun_edge_sa*>(f.owner)) {
+    f.kind=1;f.head=&p->threads_;f.mask=&p->edge_;f.bits=p->bits_;
+   } else if(auto p=dynamic_cast<vvp_fun_anyedge_sa*>(f.owner)) {
+    f.kind=2;f.head=&p->threads_;f.values=p->last_value_;
+   } else if(auto p=dynamic_cast<vvp_fun_event_or_sa*>(f.owner)) {
+    f.kind=3;f.head=&p->threads_;f.referent=p->base_net_;
+   } else if(auto p=dynamic_cast<vvp_named_event_sa*>(f.owner)) {
+    f.kind=4;f.head=&p->threads_;f.referent=p->handle_;
+   } else if(auto p=dynamic_cast<vvp_fun_edge_aa*>(f.owner)) {
+    f.kind=11;f.mask=&p->edge_;f.bits=p->bits_;scope=p->context_scope_;index=p->context_idx_;
+   } else if(auto p=dynamic_cast<vvp_fun_anyedge_aa*>(f.owner)) {
+    f.kind=12;f.values=p->last_value_;scope=p->context_scope_;index=p->context_idx_;
+   } else if(auto p=dynamic_cast<vvp_fun_event_or_aa*>(f.owner)) {
+    f.kind=13;f.referent=p->base_net_;scope=p->context_scope_;index=p->context_idx_;
+   } else if(auto p=dynamic_cast<vvp_named_event_aa*>(f.owner)) {
+    f.kind=14;f.referent=p->handle_;scope=p->robotron_context_scope_;index=p->context_idx_;
+   } else return -1;
+   // Event-controlled assignment payloads require their own typed observer.
+   if(f.owner->event_ctls || f.owner->last!=&f.owner->event_ctls)return -1;
+   out.push_back(f);
+   if(f.kind<10)continue;
+   if(!scope)return -1;
+   std::set<vvp_context_t>seen;
+   for(vvp_context_t ctx=scope->live_contexts;ctx;ctx=vvp_get_next_context(ctx)) {
+    if(!seen.insert(ctx).second)return -1;
+    Frame instance=f;instance.context=ctx;
+    auto state=static_cast<waitable_state_s*>(vvp_get_context_item(ctx,index));
+    if(!state)return -1;
+    instance.head=&state->threads;
+    if(f.kind==11)instance.bits=static_cast<vvp_fun_edge_state_s*>(state)->bits;
+    if(f.kind==12)instance.values=static_cast<vvp_fun_anyedge_state_s*>(state)->last_value_;
+    out.push_back(instance);
+   }
+  }
+  return 0;
+ }
+ static int cache(FILE*f,unsigned index,anyedge_value*value) {
+  if(!value)return fprintf(f,"VWE_CACHE %u 0 0 -\n",index)<0?-1:0;
+  if(auto p=dynamic_cast<anyedge_vec4_value*>(value)) {
+   unsigned n=p->old_bits.size();fprintf(f,"VWE_CACHE %u 1 %u ",index,n);
+   if(!n)fputc('-',f);
+   for(unsigned i=0;i<n;i++)fprintf(f,"%u",unsigned(p->old_bits.value(i)));
+  } else if(auto p=dynamic_cast<anyedge_real_value*>(value)) {
+   uint64_t bits;memcpy(&bits,&p->old_bits,sizeof(bits));
+   fprintf(f,"VWE_CACHE %u 2 64 %016llx",index,(unsigned long long)bits);
+  } else if(auto p=dynamic_cast<anyedge_string_value*>(value)) {
+   fprintf(f,"VWE_CACHE %u 3 %zu ",index,p->old_bits.size());
+   if(p->old_bits.empty())fputc('-',f);
+   for(unsigned char byte:p->old_bits)fprintf(f,"%02x",unsigned(byte));
+  } else return -1;
+  return fputc('\n',f)==EOF?-1:0;
+ }
+ static int inventory(FILE*f) {
+  std::vector<Frame>list;if(frames(list))return -1;
+  fprintf(f,"VWE_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime());
+  for(auto x:list) {
+   vthread_t head=x.head?*x.head:0;
+   unsigned long long thread=robotron_vvp_thread_identity(head);
+   if(head && !thread)return -1;
+   fprintf(f,"VWE_EVENT %llu %u %p %p %u %llu %p %p\n",x.id,x.kind,(void*)x.owner,(void*)x.context,x.head!=0,thread,(void*)head,x.referent);
+   if(x.mask) {
+    fprintf(f,"VWE_EDGE %u ",unsigned(*x.mask));
+    for(unsigned i=0;i<4;i++)fprintf(f,"%u",unsigned(x.bits[i]));
+    fputc('\n',f);
+   }
+   if(x.values)for(unsigned i=0;i<4;i++)if(cache(f,i,x.values[i]))return -1;
+  }
+  fprintf(f,"VWE_END %zu\n",list.size());return ferror(f)?-1:0;
+ }
+ static int toggle(int field) {
+  static bool active=false;static Frame saved;static int selected;
+  static vthread_t thread;static vvp_fun_edge::edge_t mask;static vvp_bit4_t bit;
+  static anyedge_vec4_value*vec;static unsigned slot;
+  std::vector<Frame>list;if(frames(list))return -1;
+  if(active) {
+   if(field!=selected)return -1;
+   bool found=false;for(auto x:list)if(x.owner==saved.owner && x.id==saved.id && x.context==saved.context)found=true;
+   if(!found)return -1;
+   if(field==0)*saved.head=thread;
+   else if(field==1)*saved.mask=mask;
+   else if(field==2)saved.bits[0]=bit;
+   else if(field==3) {
+    if(saved.values[slot]!=vec)return -1;
+    vec->old_bits.set_bit(0,bit);
+   } else return -1;
+   active=false;return 1;
+  }
+  for(auto x:list) {
+   if(field==0 && x.head && *x.head) {thread=*x.head;*x.head=0;}
+   else if(field==1 && x.mask) {mask=*x.mask;*x.mask^=1;}
+   else if(field==2 && x.bits) {bit=x.bits[0];x.bits[0]=vvp_bit4_t(unsigned(bit)^1);}
+   else if(field==3 && x.values) {
+    vec=0;
+    for(slot=0;slot<4;slot++) {
+     vec=dynamic_cast<anyedge_vec4_value*>(x.values[slot]);
+     if(vec && vec->old_bits.size())break;
+    }
+    if(slot==4)continue;
+    bit=vec->old_bits.value(0);vec->old_bits.set_bit(0,vvp_bit4_t(unsigned(bit)^1));
+   } else continue;
+   saved=x;selected=field;active=true;return 1;
+  }
+  return 0;
+ }
+};
+extern "C" int robotron_vvp_wait_inventory(FILE*f) { return RobotronWaitObserver::inventory(f); }
+extern "C" int robotron_vvp_wait_toggle(int field) { return RobotronWaitObserver::toggle(field); }
