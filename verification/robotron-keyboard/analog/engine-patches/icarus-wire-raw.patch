+static unsigned robotron_strength_byte(vvp_scalar_t value)
+{
+    static_assert(sizeof(vvp_scalar_t)==1,"Scalar representation must have no padding");
+    unsigned char raw;memcpy(&raw,&value,1);return raw;
+}
+int vvp_wire_vec8::robotron_wire_raw_inventory(FILE* out) const
+{
+    for(auto value : {&bits8_,&force8_}){
+        if(fprintf(out," %u ",value->size())<0)return -1;
+        if(!value->size() && fputc('-',out)==EOF)return -1;
+        for(unsigned i=0;i<value->size();i++)if(fprintf(out,"%02x",robotron_strength_byte(value->value(i)))<0)return -1;
+    }
+    return fputc('\n',out)==EOF || ferror(out)?-1:0;
+}
+int vvp_wire_vec8::robotron_wire_raw_toggle(int field)
+{
+    static vvp_wire_vec8* saved=0;static int saved_field;static vvp_vector8_t old;
+    if(field<0 || field>1)return -1;
+    auto& value=field==0?bits8_:force8_;
+    if(saved){if(saved!=this || field!=saved_field)return -1;value=old;saved=0;return 1;}
+    for(unsigned i=0;i<value.size();i++){
+        unsigned raw=robotron_strength_byte(value.value(i));if(raw!=0 && raw!=136)continue;
+        old=value;value.set_bit(i,raw==0?vvp_scalar_t(BIT4_1,1,0):vvp_scalar_t());
+        saved=this;saved_field=field;return 1;
+    }
+    return 0;
+}
