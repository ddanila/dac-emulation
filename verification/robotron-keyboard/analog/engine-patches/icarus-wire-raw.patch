+extern "C" int robotron_vvp_wire_raw_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations()){
+        auto fil=item.first->fil;
+        if(fil && typeid(*fil)!=typeid(vvp_wire_vec4) && typeid(*fil)!=typeid(vvp_wire_vec8))return -1;
+        if(fil && typeid(*fil)==typeid(vvp_wire_vec8))nodes[item.second]=item.first;
+    }
+    if(fprintf(out,"VWB_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:nodes){auto node=item.second;
+        if(fprintf(out,"VWB_FILTER %llu %p %p",item.first,(void*)node,(void*)node->fil)<0)return -1;
+        if(static_cast<vvp_wire_vec8*>(node->fil)->robotron_wire_raw_inventory(out))return -1;
+    }
+    return fprintf(out,"VWB_END %zu\n",nodes.size())<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_wire_raw_toggle(unsigned long long id,int field)
+{
+    for(auto item:robotron_net_allocations())if(item.second==id){
+        auto fil=item.first->fil;
+        return fil && typeid(*fil)==typeid(vvp_wire_vec8)?static_cast<vvp_wire_vec8*>(fil)->robotron_wire_raw_toggle(field):-1;
+    }
+    return -1;
+}
