+#include <typeinfo>
+struct robotron_memory_record { __vpiArray* array; const char* name; size_t bytes; };
+static std::map<vpiHandle,robotron_memory_record> robotron_memories;
+static void robotron_memory_register(__vpiArray*array) {
+    assert(array && array->name);
+    robotron_memory_record r={array,array->name,strlen(array->name)+1};
+    if(!robotron_memories.insert({static_cast<vpiHandle>(array),r}).second)abort();
+}
