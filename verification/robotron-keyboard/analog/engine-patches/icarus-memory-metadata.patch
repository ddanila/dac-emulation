+
+extern "C" int robotron_vvp_memory_owners(std::map<const void*,std::pair<unsigned long long,const void*>>*);
+extern "C" int robotron_vvp_memory_metadata_inventory(FILE*out)
+{
+    std::map<const void*,std::pair<unsigned long long,const void*>> owners;
+    if(!out || robotron_vvp_memory_owners(&owners) || owners.size()!=robotron_memories.size())return -1;
+    std::map<unsigned long long,vpiHandle> ordered;
+    for(auto item:robotron_memories){
+        auto owner=owners.find(item.first);auto r=item.second;
+        if(owner==owners.end() || typeid(*r.array)!=typeid(__vpiArray) ||
+           r.array->get_scope()!=owner->second.second || r.array->name!=r.name || !r.bytes)return -1;
+        if(!ordered.insert({owner->second.first,item.first}).second)return -1;
+    }
+    if(fprintf(out,"VMM_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:ordered){
+        auto r=robotron_memories.at(item.second);auto owner=owners.at(item.second);
+        if(fprintf(out,"VMM_MEMORY %llu %p %p %p %p %zu\n",item.first,(void*)item.second,(void*)r.array,(void*)owner.second,(void*)r.name,r.bytes)<0)return -1;
+        if(fprintf(out,"VMM_NAME ")<0)return -1;
+        for(size_t i=0;i<r.bytes;++i)if(fprintf(out,"%02x",(unsigned char)r.name[i])<0)return -1;
+        if(fputc('\n',out)==EOF)return -1;
+    }
+    return fprintf(out,"VMM_END %zu\n",ordered.size())<0?-1:0;
+}
