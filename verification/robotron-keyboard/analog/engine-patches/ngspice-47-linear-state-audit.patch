+/* Read-only Sparse audit, before factorization and immediately after solve. */
+static unsigned long audit_linear_load(CKTcircuit *ckt, int iteration, int maxIter)
+{
+    static unsigned long serial = 0;
+    MatrixPtr matrix = ckt->CKTmatrix->SPmatrix;
+    int col;
+    CKTnode *node;
+    if (!(ckt->CKTdelta <= 5.0001e-19 &&
+          ((ckt->CKTtime > .001098011 && ckt->CKTtime < .001098014) ||
+           (ckt->CKTtime > .000276499 && ckt->CKTtime < .000276502)) &&
+          (iteration <= 10 || iteration % 100 == 0 || iteration > maxIter)))
+        return 0;
+    ++serial;
+    fprintf(stderr, "LINEAR_AUDIT begin id=%lu time=%a delta=%a iteration=%d order=%d size=%d external=%d gmin=%a\n",
+        serial, ckt->CKTtime, ckt->CKTdelta, iteration, ckt->CKTorder,
+        matrix->Size, matrix->ExtSize, ckt->CKTdiagGmin);
+    for (col = 1; col <= matrix->Size; ++col) {
+        ElementPtr element;
+        for (element = matrix->FirstInCol[col]; element; element = element->NextInCol) {
+            if (element->Real != 0.0)
+                fprintf(stderr, "LINEAR_AUDIT a id=%lu row=%d col=%d value=%a\n", serial,
+                    matrix->IntToExtRowMap[element->Row], matrix->IntToExtColMap[element->Col], element->Real);
+        }
+    }
+    for (col = 1; col <= matrix->ExtSize; ++col)
+        fprintf(stderr, "LINEAR_AUDIT b id=%lu row=%d value=%a\n", serial, col, ckt->CKTrhs[col]);
+    for (node = ckt->CKTnodes; node; node = node->next)
+        fprintf(stderr, "LINEAR_AUDIT name id=%lu index=%d name=%s\n", serial, node->number, node->name);
+    return serial;
+}
 
