+extern "C" int robotron_reduction_kind(vvp_net_fun_t*);
+extern "C" int robotron_reduction_payload(vvp_net_fun_t*,FILE*);
+extern "C" int robotron_reduction_fault(vvp_net_fun_t*,int);
+extern "C" int robotron_vvp_reduction_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations()){
+        int kind=robotron_reduction_kind(item.first->fun);if(kind<0)return -1;
+        if(kind)nodes[item.second]=item.first;
+    }
+    if(fprintf(out,"VRD_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:nodes){
+        auto fun=item.second->fun;
+        if(fprintf(out,"VRD_NODE %llu %p %p %d ",item.first,(void*)item.second,(void*)fun,robotron_reduction_kind(fun))<0)return -1;
+        if(robotron_reduction_payload(fun,out))return -1;
+    }
+    return fprintf(out,"VRD_END %zu\n",nodes.size())<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_reduction_toggle(unsigned long long id,int field)
+{
+    for(auto item:robotron_net_allocations())if(item.second==id)return robotron_reduction_fault(item.first->fun,field);
+    return -1;
+}
