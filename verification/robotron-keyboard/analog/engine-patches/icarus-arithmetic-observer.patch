+#include "arith.h"
+static int robotron_arithmetic_kind(vvp_net_fun_t* fun)
+{
+    if(!fun)return 0;
+    if(typeid(*fun)==typeid(vvp_arith_sum))return 1;
+    if(typeid(*fun)==typeid(vvp_arith_sub))return 2;
+    if(typeid(*fun)==typeid(vvp_cmp_eq))return 3;
+    if(typeid(*fun)==typeid(vvp_cmp_eeq))return 4;
+    if(typeid(*fun)==typeid(vvp_cmp_nee))return 5;
+    return dynamic_cast<vvp_arith_*>(fun) || dynamic_cast<vvp_arith_real_*>(fun) ? -1:0;
+}
+extern "C" int robotron_vvp_arithmetic_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations()){
+        int kind=robotron_arithmetic_kind(item.first->fun);if(kind<0)return -1;
+        if(kind)nodes[item.second]=item.first;
+    }
+    if(fprintf(out,"VAR_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:nodes){
+        auto fun=item.second->fun;
+        if(fprintf(out,"VAR_NODE %llu %p %p %d ",item.first,(void*)item.second,(void*)fun,robotron_arithmetic_kind(fun))<0)return -1;
+        if(static_cast<vvp_arith_*>(fun)->robotron_arithmetic_inventory(out))return -1;
+    }
+    return fprintf(out,"VAR_END %zu\n",nodes.size())<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_arithmetic_toggle(unsigned long long id,int field)
+{
+    for(auto item:robotron_net_allocations())if(item.second==id){
+        auto fun=item.first->fun;
+        if(robotron_arithmetic_kind(fun)<=0)return -1;
+        return static_cast<vvp_arith_*>(fun)->robotron_arithmetic_toggle(field);
+    }
+    return -1;
+}
