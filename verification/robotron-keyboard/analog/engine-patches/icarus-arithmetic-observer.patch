+int vvp_arith_::robotron_arithmetic_inventory(FILE* out) const
+{
+    if(fprintf(out,"%u",wid_)<0)return -1;
+    for(auto bits : {&op_a_,&op_b_,&x_val_}){
+        if(fprintf(out," %u ",bits->size())<0)return -1;
+        if(!bits->size() && fputc('-',out)==EOF)return -1;
+        for(unsigned j=0;j<bits->size();j++)if(fputc('0'+(unsigned)bits->value(j),out)==EOF)return -1;
+    }
+    return fputc('\n',out)==EOF || ferror(out)?-1:0;
+}
+int vvp_arith_::robotron_arithmetic_toggle(int field)
+{
+    static vvp_arith_* saved=0;static int saved_field;static vvp_vector4_t bits;static unsigned width;
+    if(field<0 || field>3)return -1;
+    vvp_vector4_t* value=field==0?&op_a_:field==1?&op_b_:&x_val_;
+    if(saved){
+        if(saved!=this || field!=saved_field)return -1;
+        if(field==3)wid_=width;else *value=bits;
+        saved=0;return 1;
+    }
+    if(field==3){width=wid_;wid_^=1;}
+    else {if(!value->size())return 0;bits=*value;value->set_bit(0,value->value(0)==BIT4_1?BIT4_0:BIT4_1);}
+    saved=this;saved_field=field;return 1;
+}
