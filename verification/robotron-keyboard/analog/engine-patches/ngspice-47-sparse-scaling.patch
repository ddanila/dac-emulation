+
+/* Read-only audit in external equation order; called before factorization. */
+void SMPauditLinearLoad(SMPmatrix *external, double *rhs, unsigned long serial,
+                       double time, double delta, int iteration, int order, double gmin)
+{
+    MatrixPtr matrix = external->SPmatrix;
+    int col;
+    fprintf(stderr, "LINEAR_AUDIT begin id=%lu time=%a delta=%a iteration=%d order=%d size=%d external=%d gmin=%a\n",
+        serial, time, delta, iteration, order,
+        matrix->Size, matrix->ExtSize, gmin);
+    for (col = 1; col <= matrix->Size; ++col) {
+        ElementPtr element;
+        for (element = matrix->FirstInCol[col]; element; element = element->NextInCol) {
+            if (element->Real != 0.0)
+                fprintf(stderr, "LINEAR_AUDIT a id=%lu row=%d col=%d value=%a\n", serial,
+                    matrix->IntToExtRowMap[element->Row], matrix->IntToExtColMap[element->Col], element->Real);
+        }
+    }
+    for (col = 1; col <= matrix->ExtSize; ++col)
+        fprintf(stderr, "LINEAR_AUDIT b id=%lu row=%d value=%a\n", serial, col, rhs[col]);
+}
+
+/* Experimental algebraic scaling. Always restore physical solution coordinates. */
+static int diagnostic_mode = -1;
+static int diagnostic_size = 0;
+static double *row_maximum, *column_maximum, *row_scale, *column_scale;
+
+static int diagnosticMode(void)
+{
+    if (diagnostic_mode < 0) {
+        const char *mode = getenv("ROBOTRON_SPARSE_MODE");
+        diagnostic_mode = (!mode || !strcmp(mode, "off")) ? 0 :
+                          !strcmp(mode, "reorder") ? 1 : !strcmp(mode, "scale") ? 2 : -2;
+        fprintf(stderr, "SPARSE_DIAGNOSTIC mode=%d\n", diagnostic_mode);
+    }
+    return diagnostic_mode;
+}
+
+static double diagnosticPower(double maximum)
+{
+    int exponent = 0;
+    if (maximum) frexp(maximum, &exponent);
+    return scalbn(1.0, -exponent);
+}
+
+int SMPdiagnosticScale(SMPmatrix *external, double *rhs, double gmin)
+{
+    MatrixPtr matrix = external->SPmatrix;
+    int mode = diagnosticMode(), col;
+    if (mode < 2) return mode;
+    if (gmin != 0 || matrix->Complex || matrix->Size != matrix->ExtSize) {
+        fprintf(stderr, "SPARSE_DIAGNOSTIC rejected unsupported matrix or diagonal gmin\n");
+        return -1;
+    }
+    if (diagnostic_size != matrix->ExtSize) {
+        free(row_maximum); free(column_maximum); free(row_scale); free(column_scale);
+        diagnostic_size = matrix->ExtSize;
+        row_maximum = calloc((size_t)diagnostic_size+1, sizeof(double));
+        column_maximum = calloc((size_t)diagnostic_size+1, sizeof(double));
+        row_scale = calloc((size_t)diagnostic_size+1, sizeof(double));
+        column_scale = calloc((size_t)diagnostic_size+1, sizeof(double));
+        if (!row_maximum || !column_maximum || !row_scale || !column_scale) return -1;
+    }
+    memset(row_maximum, 0, ((size_t)diagnostic_size+1)*sizeof(double));
+    memset(column_maximum, 0, ((size_t)diagnostic_size+1)*sizeof(double));
+    for (col = 1; col <= matrix->Size; ++col) {
+        ElementPtr element;
+        for (element = matrix->FirstInCol[col]; element; element = element->NextInCol) {
+            int row = matrix->IntToExtRowMap[element->Row];
+            row_maximum[row] = fmax(row_maximum[row], fabs(element->Real));
+        }
+    }
+    for (col = 1; col <= diagnostic_size; ++col) row_scale[col] = diagnosticPower(row_maximum[col]);
+    for (col = 1; col <= matrix->Size; ++col) {
+        ElementPtr element;
+        int external_col = matrix->IntToExtColMap[col];
+        for (element = matrix->FirstInCol[col]; element; element = element->NextInCol)
+            column_maximum[external_col] = fmax(column_maximum[external_col],
+                fabs(element->Real*row_scale[matrix->IntToExtRowMap[element->Row]]));
+    }
+    for (col = 1; col <= diagnostic_size; ++col) column_scale[col] = diagnosticPower(column_maximum[col]);
+    for (col = 1; col <= matrix->Size; ++col) {
+        ElementPtr element;
+        int external_col = matrix->IntToExtColMap[col];
+        for (element = matrix->FirstInCol[col]; element; element = element->NextInCol) {
+            double rs = row_scale[matrix->IntToExtRowMap[element->Row]], cs = column_scale[external_col];
+            double value = (element->Real*rs)*cs;
+            if (!isfinite(value) || (value/cs)/rs != element->Real) {
+                fprintf(stderr, "SPARSE_DIAGNOSTIC rejected inexact coefficient scaling\n");
+                return -1;
+            }
+            element->Real = value;
+        }
+    }
+    for (col = 1; col <= diagnostic_size; ++col) {
+        double value = rhs[col]*row_scale[col];
+        if (!isfinite(value) || value/row_scale[col] != rhs[col]) {
+            fprintf(stderr, "SPARSE_DIAGNOSTIC rejected inexact RHS scaling\n");
+            return -1;
+        }
+        rhs[col] = value;
+    }
+    return mode;
+}
+
+int SMPdiagnosticUnscale(SMPmatrix *external, double *solution)
+{
+    int i;
+    if (diagnosticMode() != 2) return 0;
+    for (i = 1; i <= external->SPmatrix->ExtSize; ++i) {
+        double value = solution[i]*column_scale[i];
+        if (!isfinite(value) || value/column_scale[i] != solution[i]) {
+            fprintf(stderr, "SPARSE_DIAGNOSTIC rejected inexact solution unscaling\n");
+            return 1;
+        }
+        solution[i] = value;
+    }
+    return 0;
+}
