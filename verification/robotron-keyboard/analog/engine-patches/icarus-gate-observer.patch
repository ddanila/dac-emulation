+int vvp_fun_boolean_::robotron_gate_inventory(FILE* out) const
+{
+    if(fprintf(out,"%p 4",(void*)net_)<0)return -1;
+    for(unsigned i=0;i<4;i++){
+        const auto& bits=input_[i];
+        if(fprintf(out," %u ",bits.size())<0)return -1;
+        for(unsigned j=0;j<bits.size();j++)if(fputc('0'+(unsigned)bits.value(j),out)==EOF)return -1;
+    }
+    return fputc('\n',out)==EOF || ferror(out)?-1:0;
+}
+int vvp_fun_boolean_::robotron_gate_toggle(int field)
+{
+    static vvp_fun_boolean_* saved=0;static int saved_field;static vvp_vector4_t bits;static vvp_net_t* pending;
+    if(saved){
+        if(saved!=this || field!=saved_field)return -1;
+        unsigned i=field;
+        if(field==4)net_=pending;else input_[i]=bits;
+        saved=0;return 1;
+    }
+    if(field!=4 && (field<0 || field>=4))return 0;
+    unsigned i=field;
+    if(field==4){if(!net_)return 0;pending=net_;net_=0;}
+    else {auto& value=input_[i];if(!value.size())return 0;bits=value;value.set_bit(0,value.value(0)==BIT4_1?BIT4_0:BIT4_1);}
+    saved=this;saved_field=field;return 1;
+}
+
+int vvp_fun_buf_not_::robotron_gate_inventory(FILE* out) const
