+// Admit exact families: subclasses may add payload fields.
+static int robotron_gate_kind(vvp_net_fun_t* fun)
+{
+    if(!fun)return 0;
+    if(typeid(*fun)==typeid(vvp_fun_and))return 1;
+    if(typeid(*fun)==typeid(vvp_fun_or))return 2;
+    if(typeid(*fun)==typeid(vvp_fun_xor))return 3;
+    if(typeid(*fun)==typeid(vvp_fun_buf))return 4;
+    if(typeid(*fun)==typeid(vvp_fun_not))return 5;
+    return dynamic_cast<vvp_fun_boolean_*>(fun) || dynamic_cast<vvp_fun_buf_not_*>(fun) ? -1:0;
+}
+extern "C" int robotron_vvp_gate_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;std::vector<const void*> keys;
+    for(auto item:robotron_net_allocations()){
+        int kind=robotron_gate_kind(item.first->fun);if(kind<0)return -1;
+        if(kind)nodes[item.second]=item.first;
+    }
+    if(fprintf(out,"VGL_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:nodes){
+        auto fun=item.second->fun;int kind=robotron_gate_kind(fun),invert=-1;
+        auto boolean=dynamic_cast<vvp_fun_boolean_*>(fun);auto unary=dynamic_cast<vvp_fun_buf_not_*>(fun);
+        const void* key=boolean?boolean->robotron_gate_key():unary->robotron_gate_key();keys.push_back(key);
+        if(kind==1)invert=static_cast<vvp_fun_and*>(fun)->robotron_gate_invert();
+        if(kind==2)invert=static_cast<vvp_fun_or*>(fun)->robotron_gate_invert();
+        if(kind==3)invert=static_cast<vvp_fun_xor*>(fun)->robotron_gate_invert();
+        if(fprintf(out,"VGL_GATE %llu %p %p %p %d %d ",item.first,(void*)item.second,(void*)fun,key,kind,invert)<0)return -1;
+        if(boolean?boolean->robotron_gate_inventory(out):unary->robotron_gate_inventory(out))return -1;
+    }
+    unsigned events=0;if(robotron_vvp_mux_queue(out,keys.data(),keys.size(),&events))return -1;
+    return fprintf(out,"VGL_END %zu %u\n",nodes.size(),events)<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_gate_toggle(unsigned long long id,int field)
+{
+    static vvp_net_fun_t* saved=0;static int saved_field;static unsigned long long saved_id;
+    if(field<0 || field>5 || (saved && (saved_field!=field || saved_id!=id)))return -1;
+    for(auto item:robotron_net_allocations())if(item.second==id){
+        auto fun=item.first->fun;int kind=robotron_gate_kind(fun);
+        if(kind<=0 || (saved && saved!=fun))return -1;
+        int result=0;
+        if(field==5){
+            if(kind==1)static_cast<vvp_fun_and*>(fun)->robotron_gate_invert_toggle();
+            else if(kind==2)static_cast<vvp_fun_or*>(fun)->robotron_gate_invert_toggle();
+            else if(kind==3)static_cast<vvp_fun_xor*>(fun)->robotron_gate_invert_toggle();
+            else return 0;
+            result=1;
+        }else{
+            auto boolean=dynamic_cast<vvp_fun_boolean_*>(fun);auto unary=dynamic_cast<vvp_fun_buf_not_*>(fun);
+            result=boolean?boolean->robotron_gate_toggle(field):unary->robotron_gate_toggle(field);
+        }
+        if(result==1){saved=saved?0:fun;saved_field=field;saved_id=id;}
+        return result;
+    }
+    return -1;
+}
