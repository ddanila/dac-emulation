+// Resolve only explicit handoffs. No supplied object pointer is dereferenced.
+extern "C" unsigned long long robotron_vvp_signal_handle_node(vpiHandle handle,void**node)
+{
+    if(!node)return 0;
+    for(auto item:robotron_handles())if(static_cast<vpiHandle>(item.first)==handle){
+        if(!item.second.admitted || !robotron_vvp_net_handle_id(item.first->node))return 0;
+        *node=item.first->node;return item.second.id;
+    }
+    return 0;
+}
