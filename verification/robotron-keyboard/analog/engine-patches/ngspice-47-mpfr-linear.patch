+/* Experimental replacement of real linear arithmetic only. */
+int SMPmpfrSolve(SMPmatrix *external, double *rhs, double gmin, int bits)
+{
+    static RobotronMpfr solver = {0};
+    MatrixPtr matrix = external->SPmatrix;
+    int col, result;
+    if (matrix->Size != matrix->ExtSize) return 1;
+    spSetReal(external->SPmatrix);
+    LoadGmin(external, gmin);
+    if (robotron_mpfr_init(&solver, matrix->Size, bits)) return 2;
+    robotron_mpfr_reset(&solver);
+    for (col = 1; col <= matrix->Size; ++col) {
+        ElementPtr element;
+        for (element = matrix->FirstInCol[col]; element; element = element->NextInCol)
+            if (robotron_mpfr_set(&solver,
+                    matrix->IntToExtRowMap[element->Row]-1,
+                    matrix->IntToExtColMap[element->Col]-1, element->Real)) return 3;
+    }
+    for (col = 1; col <= matrix->ExtSize; ++col)
+        if (robotron_mpfr_set(&solver, col-1, matrix->Size, rhs[col])) return 4;
+    result = robotron_mpfr_solve(&solver, rhs);
+    return result ? result+4 : 0;
+}
