+static int mpfr_precision(void)
+{
+    static int bits = -1;
+    if (bits == -1) {
+        const char *value = getenv("ROBOTRON_MPFR_BITS");
+        bits = 0;
+        if (value && strcmp(value, "off")) {
+            if (!strcmp(value, "256")) bits = 256;
+            else if (!strcmp(value, "512")) bits = 512;
+            else bits = -2;
+        }
+        fprintf(stderr, "MPFR_DIAGNOSTIC bits=%d\n", bits);
+    }
+    return bits;
+}
