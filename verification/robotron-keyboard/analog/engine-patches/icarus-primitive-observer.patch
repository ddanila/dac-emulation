+int vvp_fun_not::robotron_payload(FILE* out,void* object)
+{
+    auto p=static_cast<vvp_fun_not*>(object);
+    if(fprintf(out,"VPR_DATA 1 %p %u %u %u ",(void*)p->net_,0u,0u,p->input_.size())<0)return -1;
+    if(!p->input_.size() && fputc('-',out)==EOF)return -1;
+    for(unsigned i=0;i<p->input_.size();i++)if(fputc('0'+(unsigned)p->input_.value(i),out)==EOF)return -1;
+    return fputc('\n',out)==EOF || ferror(out) ? -1 : 0;
+}
+int vvp_fun_not::robotron_toggle(void* object,int field)
+{
+    static vvp_fun_not* saved=0;static int saved_field;
+    static vvp_vector4_t value;static vvp_net_t* net;
+    
+    auto p=static_cast<vvp_fun_not*>(object);
+    if(saved){
+        if(saved!=p || saved_field!=field)return -1;
+        p->input_=value;p->net_=net;
+        saved=0;return 1;
+    }
+    if(field<0 || field>1 || !p->input_.size())return -1;
+    saved=p;saved_field=field;value=p->input_;net=p->net_;
+    if(field==0)p->input_.set_bit(0,p->input_.value(0)==BIT4_1?BIT4_0:BIT4_1);
+    else if(field==1)p->net_=0;
+    
+    return 1;
+}
