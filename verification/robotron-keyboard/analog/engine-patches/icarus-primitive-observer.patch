+struct robotron_primitive_record {
+    void* object;int kind;unsigned long long id;
+    int (*payload)(FILE*,void*);int (*toggle)(void*,int);
+};
+static std::map<const void*,robotron_primitive_record> robotron_primitive_live;
+static unsigned long long robotron_primitive_serial;
+extern "C" void robotron_vvp_primitive_register(const void* key,void* object,int kind,
+                                               int(*payload)(FILE*,void*),int(*toggle)(void*,int))
+{
+    if(!key || !object || (kind!=1 && kind!=2) || !payload || !toggle || robotron_primitive_live.count(key))abort();
+    robotron_primitive_live[key]={object,kind,++robotron_primitive_serial,payload,toggle};
+}
+extern "C" void robotron_vvp_primitive_unregister(const void* key)
+{robotron_primitive_live.erase(key);}
+extern "C" int robotron_vvp_primitive_inventory(FILE* out)
+{
+    if(!out || fprintf(out,"VPR_BEGIN 1 %llu\n",(unsigned long long)schedule_time)<0)return -1;
+    unsigned long long known=0,other=0;
+    int result=robotron_assignment_walk([&](event_s* event,long long slot,const char* region,unsigned long long ordinal) {
+        auto wrapper=dynamic_cast<generic_event_s*>(event);
+        if(!wrapper){++other;return 0;}
+        auto found=robotron_primitive_live.find(wrapper->obj);
+        if(found==robotron_primitive_live.end()){++other;return 0;}
+        const auto& r=found->second;++known;
+        if(fprintf(out,"VPR_EVENT %lld %s %llu %llu %llu %d %d\n",slot,region,ordinal,wrapper->robotron_id,r.id,r.kind,(int)wrapper->delete_obj_when_done)<0)return -1;
+        return r.payload(out,r.object);
+    });
+    return result || fprintf(out,"VPR_END %llu %llu\n",known,other)<0 || ferror(out) ? -1 : 0;
+}
+extern "C" int robotron_vvp_primitive_toggle(int kind,int field)
+{
+    static const void* saved=0;static unsigned long long saved_id;static int saved_field;
+    if(saved){
+        auto found=robotron_primitive_live.find(saved);
+        if(found==robotron_primitive_live.end() || found->second.id!=saved_id || found->second.kind!=kind || field!=saved_field)return -1;
+        int result=found->second.toggle(found->second.object,field);if(result==1)saved=0;return result;
+    }
+    if((kind!=1 && kind!=2) || field<0 || field>(kind==1?1:2))return -1;
+    int result=robotron_assignment_walk([&](event_s* event,long long,const char*,unsigned long long) {
+        if(saved)return 0;
+        auto wrapper=dynamic_cast<generic_event_s*>(event);if(!wrapper)return 0;
+        auto found=robotron_primitive_live.find(wrapper->obj);
+        if(found==robotron_primitive_live.end() || found->second.kind!=kind)return 0;
+        if(found->second.toggle(found->second.object,field)!=1)return -1;
+        saved=found->first;saved_id=found->second.id;saved_field=field;return 0;
+    });
+    return result ? -1 : saved ? 1 : 0;
+}
