+#include "resolv.h"
+static int robotron_resolver_kind(vvp_net_fun_t* fun)
+{
+    if(!fun)return 0;
+    if(typeid(*fun)==typeid(resolv_tri))return 1;
+    if(typeid(*fun)==typeid(resolv_extend))return 2;
+    return dynamic_cast<resolv_core*>(fun) || dynamic_cast<resolv_extend*>(fun)?-1:0;
+}
+extern "C" int robotron_vvp_resolver_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations()){
+        int kind=robotron_resolver_kind(item.first->fun);if(kind<0)return -1;
+        if(kind)nodes[item.second]=item.first;
+    }
+    if(fprintf(out,"VRS_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:nodes){
+        auto fun=item.second->fun;int kind=robotron_resolver_kind(fun);
+        if(fprintf(out,"VRS_NODE %llu %p %p %d ",item.first,(void*)item.second,(void*)fun,kind)<0)return -1;
+        int result=kind==1?static_cast<resolv_tri*>(fun)->robotron_resolver_inventory(out):static_cast<resolv_extend*>(fun)->robotron_resolver_inventory(out);
+        if(result)return -1;
+    }
+    return fprintf(out,"VRS_END %zu\n",nodes.size())<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_resolver_toggle(unsigned long long id,int field,unsigned index)
+{
+    for(auto item:robotron_net_allocations())if(item.second==id){
+        auto fun=item.first->fun;int kind=robotron_resolver_kind(fun);
+        if(kind==1)return static_cast<resolv_tri*>(fun)->robotron_resolver_toggle(field,index);
+        if(kind==2)return static_cast<resolv_extend*>(fun)->robotron_resolver_toggle(field,index);
+        return -1;
+    }
+    return -1;
+}
