+int resolv_tri::robotron_resolver_toggle(int field,unsigned index)
+{
+    static resolv_tri* saved=0;static int saved_field;static unsigned saved_index,ports;
+    static vvp_vector8_t old;static vvp_net_t* output;static vvp_scalar_t pull;static vvp_vector8_t* values;
+    auto found=robotron_resolver_storage().find(this);if(found==robotron_resolver_storage().end() || field<0 || field>6)return -1;
+    auto storage=found->second;
+    if((field==0 || field==1 || field==6) && index>=storage.second)return -1;
+    if(saved){
+        if(saved!=this || field!=saved_field || index!=saved_index)return -1;
+        if(field==0 || field==1 || field==6)storage.first[index]=old;
+        else if(field==2)nports_=ports;else if(field==3)net_=output;else if(field==4)hiz_value_=pull;else val_=values;
+        saved=0;return 1;
+    }
+    if(field==0 || field==1 || field==6){
+        auto& value=storage.first[index];
+        if(field==0){if(!value.size())return 0;old=value;value.set_bit(0,robotron_resolver_byte(value.value(0))==0xee?vvp_scalar_t(BIT4_0,6,6):vvp_scalar_t(BIT4_1,6,6));}
+        else if(field==1){old=value;value=vvp_vector8_t(value.size()+1);}
+        else{
+            unsigned i=0;while(i<value.size() && robotron_resolver_byte(value.value(i))!=0 && robotron_resolver_byte(value.value(i))!=136)i++;
+            if(i==value.size())return 0;
+            old=value;value.set_bit(i,robotron_resolver_byte(value.value(i))==0?vvp_scalar_t(BIT4_1,1,0):vvp_scalar_t());
+        }
+    }else if(field==2){ports=nports_;nports_^=1;}
+    else if(field==3){if(!net_)return 0;output=net_;net_=nullptr;}
+    else if(field==4){pull=hiz_value_;hiz_value_=robotron_resolver_byte(hiz_value_)==0?vvp_scalar_t(BIT4_1,5,5):vvp_scalar_t();}
+    else{values=val_;val_=nullptr;}
+    saved=this;saved_field=field;saved_index=index;return 1;
+}
