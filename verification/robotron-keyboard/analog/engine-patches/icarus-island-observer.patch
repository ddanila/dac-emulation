+int robotron_tran_inventory(FILE* out,vvp_island_branch* branch)
+{
+    auto b=dynamic_cast<vvp_island_branch_tran*>(branch);if(!b)return -1;
+    return fprintf(out,"VI_TRAN %p %u %u %u %u %u %u\n",(void*)b->en,
+                   b->width,b->part,b->offset,(unsigned)b->active_high,(unsigned)b->resistive,
+                   (unsigned)b->state)<0?-1:0;
+}
+int robotron_tran_toggle(vvp_island_branch* branch)
+{
+    static vvp_island_branch_tran* saved=0;static tran_state_t state;
+    auto b=dynamic_cast<vvp_island_branch_tran*>(branch);if(!b)return -1;
+    if(saved){if(saved!=b)return -1;b->state=state;saved=0;return 1;}
+    saved=b;state=b->state;b->state=b->state==tran_enabled?tran_disabled:tran_enabled;return 1;
+}
