+
 int
 RESload(GENmodel *inModel, CKTcircuit *ckt)
 {
+    int exact=RobotronPostCapEnabled();
+    double before[4],after[4];
+    if(exact<0)return E_BADPARM;
     RESmodel *model = (RESmodel *)inModel;
 
