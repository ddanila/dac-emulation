+/* Typed pending assignment observation: destinations stay opaque. Only queued
+ * objects are read, after their schedule_* producers initialized all payloads. */
+template<class F> static int robotron_assignment_queue(event_s* tail,long long slot,const char* region,F visit)
+{
+    if (!tail) return 0;
+    event_s* head=tail->next;event_s* cur=head;std::set<event_s*> seen;
+    unsigned long long ordinal=0;
+    for (;;) {
+        if (!cur || !seen.insert(cur).second || visit(cur,slot,region,ordinal++)) return -1;
+        if (cur==tail) return cur->next==head ? 0 : -1;
+        cur=cur->next;
+    }
+}
+template<class F> static int robotron_assignment_walk(F visit)
+{
+    if (robotron_assignment_queue(schedule_init_list,-1,"init",visit) ||
+        robotron_assignment_queue(schedule_final_list,-1,"final",visit)) return -1;
+    std::set<event_time_s*> seen;long long slot=0;
+    for (event_time_s* t=sched_list;t;t=t->next,++slot) {
+        if (!seen.insert(t).second) return -1;
+        const char* names[]={"start","active","inactive","nbassign","rwsync","rosync","del_thr"};
+        event_s* queues[]={t->start,t->active,t->inactive,t->nbassign,t->rwsync,t->rosync,t->del_thr};
+        for (unsigned i=0;i<7;i++) if(robotron_assignment_queue(queues[i],slot,names[i],visit)) return -1;
+    }
+    return 0;
+}
+extern "C" int robotron_vvp_assignment_inventory(FILE* out)
+{
+    if (!out || fprintf(out,"VAP_BEGIN 1 %llu\n",(unsigned long long)schedule_time)<0) return -1;
+    unsigned long long counts[3]={0,0,0};
+    int result=robotron_assignment_walk([&](event_s* event,long long slot,const char* region,unsigned long long ordinal) {
+        auto a=dynamic_cast<assign_vector4_event_s*>(event);
+        auto b=dynamic_cast<assign_vector8_event_s*>(event);
+        if (!a && !b) {++counts[2];return 0;}
+        auto identity=robotron_assignment_live.find(event);
+        if (identity==robotron_assignment_live.end()) return -1;
+        vvp_net_ptr_t ptr=a ? a->ptr : b->ptr;
+        unsigned size=a ? a->val.size() : b->val.size();
+        ++counts[a?0:1];
+        if (fprintf(out,"VAP_EVENT %lld %s %llu %llu %d %p %u %u %u %u ",slot,region,ordinal,
+                    identity->second,a?4:8,(const void*)ptr.ptr(),ptr.port(),a && a->vwid?a->base:0,a?a->vwid:0,size)<0) return -1;
+        if (!size && fputc('-',out)==EOF) return -1;
+        for(unsigned i=0;i<size;i++) {
+            if(a) {if(fputc('0'+(unsigned)a->val.value(i),out)==EOF)return -1;}
+            else {vvp_scalar_t value=b->val.value(i);if(fprintf(out,"%u%u%u",(unsigned)value.value(),value.strength0(),value.strength1())<0)return -1;}
+        }
+        return fputc('\n',out)==EOF ? -1 : 0;
+    });
+    if(result)return result;
+    return fprintf(out,"VAP_END %llu %llu %llu\n",counts[0],counts[1],counts[2])<0 || ferror(out) ? -1 : 0;
+}
