+/* Change actual queued data, restoring the exact original object before yield.
+ * No queue deletion or scheduling is permitted between paired calls. */
+extern "C" int robotron_vvp_assignment_toggle(int kind,int field)
+{
+    static event_s* saved=0;static unsigned long long saved_id;
+    static int saved_kind,saved_field;
+    static vvp_net_ptr_t saved_ptr;
+    static vvp_vector4_t saved4;
+    static vvp_vector8_t saved8;
+    static unsigned saved_width;
+    if(saved) {
+        auto found=robotron_assignment_live.find(saved);
+        if(kind!=saved_kind || field!=saved_field || found==robotron_assignment_live.end() || found->second!=saved_id)return -1;
+        if(kind==4){auto p=static_cast<assign_vector4_event_s*>(saved);p->ptr=saved_ptr;p->val=saved4;p->vwid=saved_width;}
+        else {auto p=static_cast<assign_vector8_event_s*>(saved);p->ptr=saved_ptr;p->val=saved8;}
+        saved=0;return 1;
+    }
+    if((kind!=4 && kind!=8) || field<0 || field>2)return -1;
+    int result=robotron_assignment_walk([&](event_s* event,long long,const char*,unsigned long long) {
+        if(saved)return 0;
+        auto a=kind==4 ? dynamic_cast<assign_vector4_event_s*>(event) : 0;
+        auto b=kind==8 ? dynamic_cast<assign_vector8_event_s*>(event) : 0;
+        if((!a && !b) || (a && !a->val.size()) || (b && !b->val.size()))return 0;
+        auto found=robotron_assignment_live.find(event);if(found==robotron_assignment_live.end())return -1;
+        saved=event;saved_id=found->second;saved_kind=kind;saved_field=field;
+        saved_ptr=a?a->ptr:b->ptr;
+        if(a){saved4=a->val;saved_width=a->vwid;}
+        else saved8=b->val;
+        if(field==0){
+            if(a)a->val.set_bit(0,a->val.value(0)==BIT4_1?BIT4_0:BIT4_1);
+            else {auto v=b->val.value(0);b->val.set_bit(0,vvp_scalar_t(v.value()==BIT4_1?BIT4_0:BIT4_1,6,6));}
+        } else if(field==1){
+            vvp_net_ptr_t changed(saved_ptr.ptr(),saved_ptr.port()^1);
+            if(a)a->ptr=changed;else b->ptr=changed;
+        } else {
+            if(a)a->vwid^=1;
+            else {auto v=b->val.value(0);b->val.set_bit(0,vvp_scalar_t(BIT4_X,v.strength0()==3?4:3,5));}
+        }
+        return 0;
+    });
+    return result ? -1 : saved ? 1 : 0;
+}
