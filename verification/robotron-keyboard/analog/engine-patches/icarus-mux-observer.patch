+#include "logic.h"
+extern "C" int robotron_vvp_mux_queue(FILE*,const void* const*,unsigned,unsigned*);
+extern "C" int robotron_vvp_mux_inventory(FILE* out)
+{
+    if(!out || robotron_net_allocations().size()!=count_vvp_nets)return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;std::vector<const void*> keys;
+    for(auto item:robotron_net_allocations())if(dynamic_cast<vvp_fun_muxz*>(item.first->fun))nodes[item.second]=item.first;
+    if(fprintf(out,"VXM_BEGIN 1 %llu\n",(unsigned long long)schedule_simtime())<0)return -1;
+    for(auto item:nodes){
+        auto mux=dynamic_cast<vvp_fun_muxz*>(item.second->fun);keys.push_back(mux->robotron_event_key());
+        if(fprintf(out,"VXM_MUX %llu %p %p %p ",item.first,(void*)item.second,(void*)mux,mux->robotron_event_key())<0 || mux->robotron_mux_inventory(out))return -1;
+    }
+    unsigned events=0;if(robotron_vvp_mux_queue(out,keys.data(),keys.size(),&events))return -1;
+    return fprintf(out,"VXM_END %zu %u\n",nodes.size(),events)<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_mux_toggle(int field)
+{
+    static vvp_fun_muxz* saved=0;static int saved_field=-1;
+    if(field<0 || field>4 || (saved && field!=saved_field))return -1;
+    std::map<unsigned long long,vvp_net_t*> nodes;
+    for(auto item:robotron_net_allocations())nodes[item.second]=item.first;
+    for(auto item:nodes){
+        auto mux=dynamic_cast<vvp_fun_muxz*>(item.second->fun);if(!mux || (saved && saved!=mux))continue;
+        int result=mux->robotron_mux_toggle(field);if(result<0)return result;
+        if(result){saved=saved?0:mux;saved_field=field;return 1;}
+    }
+    return saved?-1:0;
+}
