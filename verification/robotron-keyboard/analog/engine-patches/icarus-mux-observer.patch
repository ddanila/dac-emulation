+int vvp_fun_muxz::robotron_mux_inventory(FILE* out) const
+{
+    if(fprintf(out,"%p %u %u %u ",(void*)net_,(unsigned)select_,(unsigned)has_run_,a_.size())<0)return -1;
+    if(!a_.size())fputc('-',out);
+    for(unsigned i=0;i<a_.size();i++)if(fputc('0'+(unsigned)a_.value(i),out)==EOF)return -1;
+    if(fprintf(out," %u ",b_.size())<0)return -1;
+    if(!b_.size())fputc('-',out);
+    for(unsigned i=0;i<b_.size();i++)if(fputc('0'+(unsigned)b_.value(i),out)==EOF)return -1;
+    return fputc('\n',out)==EOF || ferror(out)?-1:0;
+}
+int vvp_fun_muxz::robotron_mux_toggle(int field)
+{
+    static vvp_fun_muxz* saved=0;static int saved_field;
+    static vvp_vector4_t bits;static sel_type selection;static bool ran;static vvp_net_t* pending;
+    if(saved){
+        if(saved!=this || field!=saved_field)return -1;
+        if(field==0)a_=bits;else if(field==1)b_=bits;else if(field==2)select_=selection;else if(field==3)has_run_=ran;else net_=pending;
+        saved=0;return 1;
+    }
+    if(field<0 || field>4)return -1;
+    if((field==0 && !a_.size()) || (field==1 && !b_.size()) || (field==4 && !net_))return 0;
+    saved=this;saved_field=field;
+    if(field==0 || field==1){auto& value=field==0?a_:b_;bits=value;value.set_bit(0,value.value(0)==BIT4_1?BIT4_0:BIT4_1);}
+    else if(field==2){selection=select_;select_=select_==SEL_PORT0?SEL_PORT1:SEL_PORT0;}
+    else if(field==3){ran=has_run_;has_run_=!has_run_;}
+    else{pending=net_;net_=0;}
+    return 1;
+}
