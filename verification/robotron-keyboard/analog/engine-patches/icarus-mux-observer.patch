+extern "C" int robotron_vvp_mux_queue(FILE* out,const void* const* keys,unsigned count,unsigned* observed)
+{
+    std::set<const void*> wanted;for(unsigned i=0;i<count;i++)wanted.insert(keys[i]);*observed=0;
+    auto emit=[&](generic_event_s* wrapper,long long slot,const char* region,unsigned long long ordinal){
+        if(!wrapper || !wanted.count(wrapper->obj))return 0;
+        ++*observed;
+        return fprintf(out,"VXM_EVENT %lld %s %llu %llu %p %u\n",slot,region,ordinal,wrapper->robotron_id,(void*)wrapper->obj,(unsigned)wrapper->delete_obj_when_done)<0?-1:0;
+    };
+    if(robotron_assignment_walk([&](event_s* e,long long slot,const char* region,unsigned long long ordinal){return emit(dynamic_cast<generic_event_s*>(e),slot,region,ordinal);}))return -1;
+    unsigned depth=0;
+    for(auto f=robotron_generic_executing;f;f=f->previous)if(emit(f->event,-2,"executing",depth++))return -1;
+    return ferror(out)?-1:0;
+}
