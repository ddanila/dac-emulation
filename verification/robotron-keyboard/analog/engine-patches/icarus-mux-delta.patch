+// Scan all fields; encode each mux independently against an immutable reference. Wrapper records are complete on every frame.
+static std::map<unsigned long long,std::string> robotron_mux_reference_rows;
+static bool robotron_mux_reference_ready;
+static int robotron_mux_rows(std::map<unsigned long long,std::string>& rows,std::vector<std::string>& events)
+{
+    char* data=0;size_t size=0;FILE* stream=open_memstream(&data,&size);
+    if(!stream)return -1;
+    int result=robotron_vvp_mux_inventory(stream);
+    if(fclose(stream))result=-1;
+    if(result){free(data);return -1;}
+    std::string text(data,size);free(data);std::istringstream input(text);std::string line;
+    if(!std::getline(input,line) || line.compare(0,10,"VXM_BEGIN "))return -1;
+    unsigned long long id=0;
+    while(std::getline(input,line)){
+        if(line.compare(0,8,"VXM_MUX ")==0){
+            std::istringstream row(line);std::string marker;row>>marker>>id;
+            if(!id || rows.count(id) || !events.empty())return -1;
+            rows[id]=line+"\n";
+        }else if(line.compare(0,10,"VXM_EVENT ")==0){
+            events.push_back(line);
+        }else if(line=="VXM_END "+std::to_string(rows.size())+" "+std::to_string(events.size())){
+            return std::getline(input,line)?-1:0;
+        }else return -1;
+    }
+    return -1;
+}
+static int robotron_mux_row(FILE* out,unsigned long long id,const std::string& row,const std::string& reference)
+{
+    size_t prefix=0,suffix=0;
+    while(prefix<row.size() && prefix<reference.size() && row[prefix]==reference[prefix])prefix++;
+    while(suffix<row.size()-prefix && suffix<reference.size()-prefix && row[row.size()-1-suffix]==reference[reference.size()-1-suffix])suffix++;
+    if(fprintf(out,"VXD_ROW %llu %zu %zu ",id,prefix,suffix)<0)return -1;
+    static const char digits[]="0123456789abcdef";
+    if(prefix+suffix==row.size()){if(fputc('-',out)==EOF)return -1;}
+    else for(size_t i=prefix;i<row.size()-suffix;i++){
+        unsigned char c=row[i];if(fputc(digits[c>>4],out)==EOF || fputc(digits[c&15],out)==EOF)return -1;
+    }
+    return fputc('\n',out)==EOF?-1:0;
+}
+extern "C" int robotron_vvp_mux_reference(FILE* out)
+{
+    if(!out || robotron_mux_reference_ready)return -1;
+    std::map<unsigned long long,std::string> rows;std::vector<std::string> events;
+    if(robotron_mux_rows(rows,events))return -1;
+    if(fprintf(out,"VXD_BEGIN R %llu %zu %zu %zu\n",(unsigned long long)schedule_simtime(),rows.size(),rows.size(),events.size())<0)return -1;
+    for(auto row:rows)if(robotron_mux_row(out,row.first,row.second,""))return -1;
+    for(const auto& event:events)if(fprintf(out,"%s\n",event.c_str())<0)return -1;
+    if(fprintf(out,"VXD_END %zu %zu\n",rows.size(),events.size())<0 || ferror(out))return -1;
+    robotron_mux_reference_rows=rows;robotron_mux_reference_ready=true;return 0;
+}
+extern "C" int robotron_vvp_mux_delta_inventory(FILE* out)
+{
+    if(!out || !robotron_mux_reference_ready)return -1;
+    std::map<unsigned long long,std::string> rows;std::vector<std::string> events;
+    if(robotron_mux_rows(rows,events))return -1;
+    for(auto row:robotron_mux_reference_rows)if(!rows.count(row.first))return -1;
+    size_t changed=0;
+    for(auto row:rows){auto old=robotron_mux_reference_rows.find(row.first);if(old==robotron_mux_reference_rows.end() || old->second!=row.second)changed++;}
+    if(fprintf(out,"VXD_BEGIN D %llu %zu %zu %zu\n",(unsigned long long)schedule_simtime(),rows.size(),changed,events.size())<0)return -1;
+    for(auto row:rows){
+        auto old=robotron_mux_reference_rows.find(row.first);
+        if(old==robotron_mux_reference_rows.end() || old->second!=row.second)
+            if(robotron_mux_row(out,row.first,row.second,old==robotron_mux_reference_rows.end()?"":old->second))return -1;
+    }
+    for(const auto& event:events)if(fprintf(out,"%s\n",event.c_str())<0)return -1;
+    return fprintf(out,"VXD_END %zu %zu\n",changed,events.size())<0 || ferror(out)?-1:0;
+}
