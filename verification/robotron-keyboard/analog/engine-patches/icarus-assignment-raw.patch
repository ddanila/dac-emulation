+/* Queue ownership and synchronous dispatch ownership are disjoint. Only fully
+ * initialized queued/executing objects are read; the allocation map alone is
+ * not proof that constructor fields have been initialized. */
+template<class F> static int robotron_assign8_walk(F visit)
+{
+    std::set<const event_s*> seen;
+    auto admit=[&](event_s* e,long long slot,const char* region,unsigned long long ordinal) {
+        auto p=dynamic_cast<assign_vector8_event_s*>(e);
+        if(!p)return 0;
+        if(typeid(*p)!=typeid(assign_vector8_event_s) || !seen.insert(e).second)return -1;
+        auto id=robotron_assignment_live.find(e);
+        if(id==robotron_assignment_live.end() || !p->ptr.ptr())return -1;
+        return visit(p,id->second,slot,region,ordinal);
+    };
+    if(robotron_assignment_walk(admit))return -1;
+    std::set<const robotron_assign8_frame*> frames;unsigned long long depth=0;
+    for(auto f=robotron_assign8_executing;f;f=f->previous) {
+        if(!frames.insert(f).second || admit(f->event,-2,"executing",depth++))return -1;
+    }
+    return 0;
+}
+extern "C" int robotron_vvp_assignment_raw_inventory(FILE* out)
+{
+    if(!out || robotron_assign8_walk([](assign_vector8_event_s*,unsigned long long,long long,const char*,unsigned long long){return 0;}))return -1;
+    if(fprintf(out,"VAR_BEGIN 1 %llu\n",(unsigned long long)schedule_time)<0)return -1;
+    unsigned long long count=0;
+    int result=robotron_assign8_walk([&](assign_vector8_event_s* p,unsigned long long id,long long slot,const char* region,unsigned long long ordinal){
+        ++count;
+        if(fprintf(out,"VAR_EVENT %lld %s %llu %llu %p %p %u %u ",slot,region,ordinal,id,(void*)p,(void*)p->ptr.ptr(),p->ptr.port(),p->val.size())<0)return -1;
+        if(!p->val.size() && fputc('-',out)==EOF)return -1;
+        for(unsigned i=0;i<p->val.size();i++) {
+            auto scalar=p->val.value(i);unsigned char raw;
+            static_assert(sizeof(scalar)==1,"raw scalar layout");memcpy(&raw,&scalar,1);
+            if(fprintf(out,"%02x",raw)<0)return -1;
+        }
+        return fputc('\n',out)==EOF?-1:0;
+    });
+    return result || fprintf(out,"VAR_END %llu\n",count)<0 || ferror(out)?-1:0;
+}
+/* Target a lifetime identity so every queued/executing payload can be tested.
+ * Paired restoration must precede propagation, scheduling or object deletion. */
+extern "C" int robotron_vvp_assignment_raw_toggle(unsigned long long identity,int op)
+{
+    static assign_vector8_event_s* saved=0;static unsigned long long saved_id;
+    static int saved_op;static vvp_vector8_t saved_value;static vvp_net_ptr_t saved_ptr;
+    if(op<0 || op>3)return -1;
+    assign_vector8_event_s* target=0;
+    if(robotron_assign8_walk([&](assign_vector8_event_s* p,unsigned long long id,long long,const char*,unsigned long long){if(id==identity)target=p;return 0;}))return -1;
+    if(saved) {
+        if(identity!=saved_id || op!=saved_op || target!=saved)return -1;
+        target->val=saved_value;target->ptr=saved_ptr;saved=0;return 1;
+    }
+    if(!target)return 0;
+    unsigned index=0;unsigned char raw=0;
+    if(op<2) {
+        for(;index<target->val.size();index++) {
+            auto scalar=target->val.value(index);memcpy(&raw,&scalar,1);
+            if(op==0 || raw==0 || raw==136)break;
+        }
+        if(index==target->val.size())return 0;
+    }
+    saved=target;saved_id=identity;saved_op=op;saved_value=target->val;saved_ptr=target->ptr;
+    if(op==2)target->val=vvp_vector8_t(target->val.size()+1);
+    else if(op==3)target->ptr=vvp_net_ptr_t(target->ptr.ptr(),target->ptr.port()^1);
+    else {raw=op==1?raw^136:raw==238?102:238;vvp_scalar_t scalar;memcpy(&scalar,&raw,1);target->val.set_bit(index,scalar);}
+    return 1;
+}
