+extern "C" int robotron_vvp_thread_queue_inventory(FILE* out)
+{
+    if(!out || fprintf(out,"VTQ_BEGIN 1 %llu\n",(unsigned long long)schedule_time)<0)return -1;
+    unsigned long long known=0,other=0;
+    int result=robotron_assignment_walk([&](event_s* event,long long slot,const char* region,unsigned long long ordinal){
+        auto thread=dynamic_cast<vthread_event_s*>(event);auto deletion=dynamic_cast<del_thr_event_s*>(event);
+        if(!thread && !deletion){++other;return 0;}
+        auto object=thread?thread->thr:deletion->thr;auto id=thread?thread->robotron_id:deletion->robotron_id;
+        ++known;
+        return fprintf(out,"VTQ_EVENT %lld %s %llu %llu %u %llu %p\n",slot,region,ordinal,id,
+                       thread?1u:2u,robotron_vvp_thread_identity(object),(void*)object)<0?-1:0;
+    });
+    return result || fprintf(out,"VTQ_END %llu %llu\n",known,other)<0 || ferror(out)?-1:0;
+}
+extern "C" int robotron_vvp_thread_queue_toggle()
+{
+    static vthread_event_s* saved=0;static vthread_t object=0;static unsigned long long identity=0;
+    vthread_event_s* found=0;
+    int result=robotron_assignment_walk([&](event_s* event,long long,const char*,unsigned long long){
+        auto thread=dynamic_cast<vthread_event_s*>(event);if(!thread || found)return 0;
+        if(saved){if(thread==saved && thread->robotron_id==identity)found=thread;}
+        else if(robotron_vvp_thread_identity(thread->thr))found=thread;
+        return 0;
+    });
+    if(result)return -1;if(!found)return saved?-1:0;
+    if(saved){found->thr=object;saved=0;object=0;return 1;}
+    saved=found;object=found->thr;identity=found->robotron_id;found->thr=0;return 1;
+}
