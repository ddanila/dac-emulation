+extern "C" int robotron_vvp_thread_compact_inventory(FILE* out)
+{
+    if(!out || (running_thread && !robotron_thread_id(running_thread)))return -1;
+    if(fprintf(out,"VT_BEGIN 1 %llu %llu\n",(unsigned long long)schedule_simtime(),robotron_thread_id(running_thread))<0)return -1;
+    map<unsigned long long,vthread_t> ordered;
+    for(const auto& item:robotron_threads())ordered[item.second]=item.first;
+    for(const auto& item:ordered)if(item.second->robotron_inventory(out,true))return -1;
+    return fprintf(out,"VT_END %zu\n",ordered.size())<0 || ferror(out)?-1:0;
