.param horizontal_choke_l=0.0001
.param horizontal_linearity_r=0.1
.param horizontal_linearity_l=2e-05
.param horizontal_compensation_r=0.1
.param horizontal_compensation_l=5e-06
.param horizontal_brightness_fraction=0.5
.param horizontal_focus_fraction=0.5
