.param horizontal_trim_fraction=0.5
.param horizontal_tank_l=0.00145
.param horizontal_tank_r=1
.param horizontal_coupling=0.995
.param horizontal_driver_l=0.005
.param horizontal_driver_r=2
.param horizontal_driver_ratio=3
